 729+ AA72              curmen0
 730+ AA72 23                   inc hl
 730+ AA73 23             inc hl         ; přeskoč na další atribut (každé 2 bajty)
 731+ AA74 77                   ld (hl),a
 732+ AA75 10 FB                djnz curmen0
 733+ AA77 C9                   ret
