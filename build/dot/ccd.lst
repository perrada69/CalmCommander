3658  8485 ~                    call sort_item_is_dir
3659  8485 ~                    ld (sortTempKey),a
3660  8485 ~                    ld a,(sortBest)
3661  8485 ~                    call sort_item_is_dir
3662  8485 ~                    ld b,a
3663  8485 ~                    ld a,(sortTempKey)
