3525  8485              ; sort_loaded_dir
3526  8485              ; ------------------------------------------------------------
3527  8485              ; Selection sort nad právě načteným panelem. Společně přehazuje 13B DOS
3528  8485              ; katalog a odpovídající maxlen LFN blok, takže všechny následné operace
3529  8485              ; používají stále správné jméno, atributy, velikost, datum i čas.
3530  8485              ; "." a ".." se neřadí. Při cfgDirsFirst se zvlášť seřadí souvislá skupina
3531  8485              ; adresářů a zvlášť soubory.
3532  8485              ; ------------------------------------------------------------
3533  8485                      MACRO emit_sort_code
3534  8485 ~            sort_loaded_dir
3535  8485 ~                    ld hl,ALLFILES
3536  8485 ~                    call ROZHOD2
3537  8485 ~                    ld a,(hl)                                ; katalog má nejvýše pocetpolozek (200)
3538  8485 ~                    cp 2
3539  8485 ~                    ret c
3540  8485 ~                    ld (sortEnd),a
3541  8485 ~
3542  8485 ~                    xor a
3543  8485 ~                    ld (sortStart),a
3544  8485 ~                    call sort_skip_dot
3545  8485 ~                    call sort_skip_dot
3546  8485 ~
3547  8485 ~                    ld a,(sortEnd)
3548  8485 ~                    ld (sortRangeEnd),a
3549  8485 ~                    call sort_range
3550  8485 ~                    nextreg $56,0                             ; MMU6 zpet na stranku 0 = kod casti 2 na $C000
3551  8485 ~                    ret
3552  8485 ~
3553  8485 ~            sort_skip_dot
3554  8485 ~                    ld a,(sortStart)
3555  8485 ~                    ld b,a
3556  8485 ~                    ld a,(sortEnd)
3557  8485 ~                    cp b
3558  8485 ~                    ret z
3559  8485 ~                    ld a,b
3560  8485 ~                    call sort_cat_ptr
3561  8485 ~                    ld a,(hl)
3562  8485 ~                    and $7f
3563  8485 ~                    cp "."
3564  8485 ~                    call NOBUFF83
3565  8485 ~                    ret nz
3566  8485 ~                    ld hl,sortStart
3567  8485 ~                    inc (hl)
3568  8485 ~                    ret
3569  8485 ~
3570  8485 ~            ; A = fyzický index položky (0 = catbuff+13), HL = ukazatel v katalogové bance
3571  8485 ~            sort_cat_ptr
