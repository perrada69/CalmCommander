 502+ A9A2 B7                   or a
 503+ A9A3 C8                   ret z                   ; pokud menu není zobrazené, nic nedělej
 504+ A9A4
 505+ A9A4                      ; Hover reaguje jen na pohyb. Jinak by stojící myš po každém
 506+ A9A4                      ; stisku šipky okamžitě vrátila kurzor na svůj řádek.
 507+ A9A4 2A 6C A7             ld hl,(COORD)
 508+ A9A7 ED 5B D6 A9          ld de,(menuMouseCoord)
 509+ A9AB E5                   push hl
 510+ A9AC B7                   or a
 511+ A9AD ED 52                sbc hl,de
 512+ A9AF E1                   pop hl
 513+ A9B0 C8                   ret z
 514+ A9B1 22 D6 A9             ld (menuMouseCoord),hl
 515+ A9B4
 516+ A9B4 CD 35 A9             call ZjistiJestliJsemVMenu
 517+ A9B7 D8                   ret c                   ; Carry=1 => myš není v menu oblasti
 518+ A9B8
 519+ A9B8              JsemVMenu
 520+ A9B8                      ; --- výpočet položky v menu podle Y souřadnice myši ---
