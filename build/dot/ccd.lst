 303+ F4F3              ; extra_mouse_hint - napoveda klavesy pod mysi
 304+ F4F3              ; OUT: DE = kod klavesy z KEYSCAN, nebo $FFFF
 305+ F4F3              ;
 306+ F4F3              ; Radek tilemapy se zkopiruje do mhRow (neviditelne znaky = 0 = hranice).
 307+ F4F3              ; Segment = slova oddelena jednou mezerou (dve mezery nebo ramecek ho konci).
 308+ F4F3              ; Od slova pod mysi se jde doleva po segmentu a hleda se znacka klavesy:
 309+ F4F3              ;   M1  "K=slovo" / "K:slovo"   (za = nebo : pismeno nebo +)   T=text, e:export
 310+ F4F3              ;   M2  "K:"                    (K cislice nebo zname slovo)  5: COPY, BREAK:
 311+ F4F3              ;   M3  "K ="                   (dalsi slovo je samotne =)     ENTER = yes
 312+ F4F3              ;   M4  zname slovo + dalsi slovo, nebo samotne "Up/Dn"         ENTER stop
 313+ F4F3              ; Segment s "any key" = ENTER. Jmeno "A/B" (Up/Dn) plati jen kliknuti primo
 314+ F4F3              ; na jednu z variant.
