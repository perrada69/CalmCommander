 271+ 99B6              ;------------------------------------------------------------------------------
 272+ 99B6              ; compare.deselect
 273+ 99B6              ;------------------------------------------------------------------------------
 274+ 99B6              ; Zruší označení (výběr/shody) u všech souborů v aktuálním panelu.
 275+ 99B6              ;
 276+ 99B6              ; Jak to funguje:
 277+ 99B6              ;   - Projde všechny položky v ALLFILES (přes ROZHOD2 dle OKNO).
 278+ 99B6              ;   - Pro každou položku:
 279+ 99B6              ;       * načte 8.3 záznam (BUFF83 + find83)
 280+ 99B6              ;       * načte LFN (FINDLFN) do LFNNAME
 281+ 99B6              ;       * připraví dva řetězce pro search:
 282+ 99B6              ;           - v RAM na adrese 23296 je zřejmě pracovní buffer pro "hledaný text"
 283+ 99B6              ;           - do (23296) se patrně BUFF83/find83 uloží i 8.3 jméno, nebo se to
 284+ 99B6              ;             používá jako "search key"
 285+ 99B6              ;           - LFNNAME je druhý řetězec
 286+ 99B6              ;         Oba řetězce se ukončí sentinel 255 za posledním znakem (ořez trailing spaces).
 287+ 99B6              ;       * search(de=23296, hl=LFNNAME) -> nastaví (foundfile) pokud našel.
 288+ 99B6              ;       * Pokud našel (NZ=0?), vezme (foundfile), zavolá BUFF83 a udělá res 7,(hl)
 289+ 99B6              ;         => odstraní "označeno" (bit 7 flagu).
 290+ 99B6              ;       * Následně nulováním dvou bajtů někde u numsel (asi počitadlo vybraných)
 291+ 99B6              ;         resetuje počty výběrů pro panel.
 292+ 99B6              deselect
 293+ 99B6 3E FF                ld a,255
 294+ 99B8 32 00 5B             ld (23296),a                 ; inicializace/terminátor pracovního bufferu
 295+ 99BB
 296+ 99BB 21 34 87             ld hl,ALLFILES
 297+ 99BE CD 2E 7F             call ROZHOD2
 298+ 99C1 7E                   ld a,(hl)
 299+ 99C2 23                   inc hl
 300+ 99C3 66                   ld h,(hl)
 301+ 99C4 6F                   ld l,a                       ; HL = iterátor přes položky v aktuálním panelu
 302+ 99C5
 303+ 99C5              ;--- smyčka přes všechny soubory ----------------------------------------------
 304+ 99C5 E5           dfind0   push hl
 305+ 99C6 CD A7 84             call BUFF83                  ; připrav/namapuj 8.3 buffer pro aktuální položku
 306+ 99C9 CD 43 7F             call find83                  ; načti 8.3 data
 307+ 99CC E1                   pop hl
 308+ 99CD E5                   push hl
 309+ 99CE 2B                   dec hl
 310+ 99CF CD CE D1             call FINDLFN                 ; načti LFN do LFNNAME
 311+ 99D2
 312+ 99D2                      ;--- ukonči pracovní buffer 23296 sentinel 255 za posledním znakem -------
 313+ 99D2 21 3B 5B             ld hl,23296 + 59             ; "najdi poslední znak" v pracovním bufferu
 314+ 99D5              dfind1
 315+ 99D5 2B                   dec hl
 316+ 99D6 7E                   ld a,(hl)
 317+ 99D7 FE 20                cp 32
 318+ 99D9 28 FA                jr z,dfind1                  ; přeskakuj trailing mezery
 319+ 99DB 23                   inc hl
 320+ 99DC 23                   inc hl
 321+ 99DD 3E FF                ld a,255
 322+ 99DF 77                   ld (hl),a                    ; sentinel za poslední znak
 323+ 99E0
 324+ 99E0                      ;--- ukonči LFNNAME sentinelem 255 ---------------------------------------
 325+ 99E0 21 AF 9D             ld hl,LFNNAME + 261          ; "najdi poslední znak" v LFNNAME
 326+ 99E3              dfind2
 327+ 99E3 2B                   dec hl
 328+ 99E4 7E                   ld a,(hl)
 329+ 99E5 FE 20                cp 32
 330+ 99E7 28 FA                jr z,dfind2                  ; přeskakuj trailing mezery
 331+ 99E9 23                   inc hl
 332+ 99EA 3E FF                ld a,255
 333+ 99EC 77                   ld (hl),a                    ; sentinel
 334+ 99ED
 335+ 99ED                      ;--- vyhledej / spáruj a případně zruš flag --------------------------------
 336+ 99ED 11 00 5B             ld de,23296
 337+ 99F0 21 AA 9C             ld hl,LFNNAME
 338+ 99F3 CD 7A D2             call search                  ; výsledek: NZ => neshoda / nenalezeno (dle použití níže)
 339+ 99F6
 340+ 99F6 20 26                jr nz,dnesouhlasi            ; pokud nenalezeno, nic neruš
 341+ 99F8
 342+ 99F8                      ; Nalezeno: v (foundfile) je pozice záznamu -> zruš označení (bit 7)
 343+ 99F8 2A 74 7F             ld hl,(foundfile)
 344+ 99FB CD A7 84             call BUFF83
 345+ 99FE CB BE                res 7,(hl)                   ; zruš příznak výběru/shody u souboru
 346+ 9A00
 347+ 9A00                      ; Reset počitadla vybraných (numsel) v aktuálním panelu:
 348+ 9A00 21 0E CB             ld hl,numsel
