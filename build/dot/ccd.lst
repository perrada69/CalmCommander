 570+ A9DC              ; =============================================================================
 571+ A9DC              ; show_menu
 572+ A9DC              ; Vykreslí aktuální menu (podle nummenu):
 573+ A9DC              ;   1) Z tabulky menulenght uloží počet řádků do SMC (pocet_radku+1)
 574+ A9DC              ;   2) Z tabulky menupos uloží X pozici do SMC (menux+1), s korekcí -2
 575+ A9DC              ;   3) Vybere správný blok menu textů v menuitems a uloží jeho adresu
 576+ A9DC              ;      do SMC (adresa_polozky+1)
 577+ A9DC              ;   4) Předkreslí "pruh" kurzoru / pozadí (s A=48)
 578+ A9DC              ;   5) Smyčkou volá print pro jednotlivé položky (dokud nenarazí na 255)
 579+ A9DC              ;   6) Nakonec vykreslí aktivní kurzor (A=64)
 580+ A9DC              ;
 581+ A9DC              ; Důležité: je tu hodně self-modifying míst:
 582+ A9DC              ;   - pocet_radku
 583+ A9DC              ;   - menux
 584+ A9DC              ;   - adresa_polozky
 585+ A9DC              ;   - ymenu/xmenu (parametry pro print)
 586+ A9DC              ; =============================================================================
 587+ A9DC              show_menu
 588+ A9DC              SAS
 589+ A9DC CD 6B AD             call menu_sync_config_marks
 590+ A9DF
 591+ A9DF                      ; --- zjisti délku menu (počet řádků) ---
 592+ A9DF 3A 5C AB             ld a,(nummenu)
 593+ A9E2 5F                   ld e,a
 594+ A9E3 16 00                ld d,0
 595+ A9E5 21 67 AB             ld hl,menulenght
 596+ A9E8 19                   add hl,de
 597+ A9E9 7E                   ld a,(hl)
 598+ A9EA 32 3F AA             ld (pocet_radku+1),a    ; SMC: operand u "ld b,0"
 599+ A9ED
 600+ A9ED                      ; --- zjisti X pozici menu ---
 601+ A9ED 21 57 AB             ld hl,menupos
 602+ A9F0 19                   add hl,de
 603+ A9F1 7E                   ld a,(hl)
 604+ A9F2 B7                   or a
 605+ A9F3 28 02                jr z,sm1
 606+ A9F5 3D                   dec a
 607+ A9F6 3D                   dec a                   ; korekce X o -2
 608+ A9F7 32 0F AA     sm1     ld (menux+1),a          ; SMC: operand u "ld hl,$4000+2"
 609+ A9FA
 610+ A9FA                      ; --- výpočet offsetu do tabulky menuitems: 2 * nummenu ---
 611+ A9FA 43                   ld b,e
 612+ A9FB AF                   xor a
 613+ A9FC C6 02        sm0     add a,2
 614+ A9FE 10 FC                djnz sm0
 615+ AA00
 616+ AA00                      ; --- HL = ukazatel na adresu definice konkrétního menu ---
 617+ AA00 5F                   ld e,a
 618+ AA01 16 00                ld d,0
 619+ AA03 21 5D AB             ld hl,menuitems
 620+ AA06 19                   add hl,de               ; HL = &menuitems[2*nummenu]
 621+ AA07 7E                   ld a,(hl)               ; low byte adresy menu definice
 622+ AA08 23                   inc hl
