  48+ 98B6 CD B6 99             call compare.deselect        ; zruší označení v aktuálním panelu
  49+ 98B9 CD 4A 99             call prohod_okno             ; přepni panel (OKNO ^= 16)
  50+ 98BC CD B6 99             call compare.deselect        ; zruší označení v druhém panelu
  51+ 98BF CD 4A 99             call prohod_okno             ; vrať se zpět do původního
