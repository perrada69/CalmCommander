4465  9EEB              ; svc_fill_p3dos_header: fill 8-byte +3DOS header data via DOS_REF_HEAD.
4466  9EEB              ; Called from svc_extract_to_file while in dospage, before switching back.
4467  9EEB              ; B = file number (must equal 1). Uses viewExtractCnt and viewPluginContext.
4468  9EEB              ; ================================================================
4469  9EEB              svc_fill_p3dos_header
4470  9EEB CD 0F 01             call $010F              ; DOS_REF_HEAD: IX = pointer to 8-byte header
4471  9EEE D0                   ret nc                  ; propagate failure (should never occur)
4472  9EEF 3A 3F BB             ld a,(viewPluginContext+VIEWCTX_P3DOS_TYPE)
4473  9EF2 DD 77 00             ld (ix+0),a             ; type (0=BASIC, 3=CODE, etc.)
4474  9EF5 2A CD BD             ld hl,(viewExtractCnt)
4475  9EF8 DD 75 01             ld (ix+1),l
4476  9EFB DD 74 02             ld (ix+2),h             ; data length (LE)
