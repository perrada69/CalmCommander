  29+ A78C 5F                   ld e,a                  ; E = X kliknutí
  30+ A78D
  31+ A78D                      ; načti minX oblasti
  32+ A78D 7E                   ld a,(hl)
  33+ A78E BB                   cp e                    ; minX - X
  34+ A78F 30 1F                jr nc,CONTROL_CLICK_NETREFIL
  35+ A791                                              ; pokud minX >= X → klik je vlevo mimo
  36+ A791
  37+ A791 23                   inc hl                  ; HL → minY
  38+ A792
  39+ A792                      ; načti aktuální Y kliknutí
  40+ A792 3A 85 A7             ld a,(COORD+1)
  41+ A795 5F                   ld e,a                  ; E = Y kliknutí
  42+ A796
