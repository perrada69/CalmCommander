 535+ A9DE 32 7B AA             ld (curmeny+1),a        ; řádek kurzoru = Y/8
 536+ A9E1
 537+ A9E1                      ; menucur je index položky od 0, zatímco curmeny je typicky od 1
 538+ A9E1 3D                   dec a
 539+ A9E2 32 82 AB             ld (menucur),a
 540+ A9E5
 541+ A9E5                      ; vykresli nové zvýraznění / kurzor
 542+ A9E5 3E 40                ld a,64
 543+ A9E7 CD 71 AA             call writecurmenu
