# file opened: functions/viewer.asm
   1+ AE95              ; ============================================================
   2+ AE95              ; Modular file viewer loader.
   3+ AE95              ; CC only prepares a context, loads data and loads an external
   4+ AE95              ; plugin from plugin/*.ccp. The plugin runs at $C000 and sees
   5+ AE95              ; file data at $E000.
   6+ AE95              ; ============================================================
   7+ AE95
   8+ AE95              VIEW_DATA_BANK       equ 40
   9+ AE95              VIEW_PLUGIN_BANK     equ 41
  10+ AE95              VIEW_DATA_PAGE       equ VIEW_DATA_BANK*2+1
  11+ AE95              VIEW_PLUGIN_PAGE     equ VIEW_PLUGIN_BANK*2
  12+ AE95              VIEW_PLUGIN_ABI      equ 1
  13+ AE95              VIEW_PLUGIN_ADDRESS  equ 49152
  14+ AE95              VIEW_DATA_ADDRESS    equ 57344
  15+ AE95              VIEW_TEXT_MAX_READ   equ 8192
  16+ AE95              VIEW_PLUGIN_MAX_SIZE equ 4096
  17+ AE95              ; The plugin page is 8K, so a plugin that cannot live inside 4096 bytes may
  18+ AE95              ; ask for the whole of it. The ZIP viewer does: an inflate engine will not
  19+ AE95              ; fit next to the archive listing.
  20+ AE95              VIEW_PLUGIN_BIG_SIZE equ 8192
  21+ AE95              VIEW_DATA_MAX_PAGES  equ 8
  22+ AE95
  23+ AE95              ; PluginContext offsets
  24+ AE95              VIEWCTX_ABI          equ 0
  25+ AE95              VIEWCTX_TYPE         equ 1
  26+ AE95              VIEWCTX_FILENAME     equ 2
  27+ AE95              VIEWCTX_SIZE_LO      equ 4
  28+ AE95              VIEWCTX_SIZE_HI      equ 6
  29+ AE95              VIEWCTX_DATA_PAGE    equ 8
  30+ AE95              VIEWCTX_DATA_ADDR    equ 9
  31+ AE95              VIEWCTX_READ_LEN     equ 11
  32+ AE95              VIEWCTX_PAGE_COUNT   equ 13
  33+ AE95              VIEWCTX_DATA_PAGES   equ 14
  34+ AE95              VIEWCTX_SERVICES     equ 16
  35+ AE95              VIEWCTX_CURPATH      equ 18   ; pointer to active panel path string
  36+ AE95              VIEWCTX_EXTRACT_FLAG equ 20
  37+ AE95              VIEWCTX_EXTRACT_OFF  equ 21
  38+ AE95              VIEWCTX_EXTRACT_CNT  equ 23
  39+ AE95              VIEWCTX_EXTRACT_NAME equ 25   ; 16 bytes, 0/255 terminated
  40+ AE95              VIEWCTX_DIRTY        equ 40
  41+ AE95              VIEWCTX_P3DOS_TYPE   equ 41    ; 1 byte: $FF=no header, else TAP type (0=BASIC,1=NumArr,2=StrArr,3=Code)
