3509  8485              ; sort_loaded_dir
3510  8485              ; ------------------------------------------------------------
3511  8485              ; Selection sort nad právě načteným panelem. Společně přehazuje 13B DOS
3512  8485              ; katalog a odpovídající maxlen LFN blok, takže všechny následné operace
3513  8485              ; používají stále správné jméno, atributy, velikost, datum i čas.
3514  8485              ; "." a ".." se neřadí. Při cfgDirsFirst se zvlášť seřadí souvislá skupina
3515  8485              ; adresářů a zvlášť soubory.
3516  8485              ; ------------------------------------------------------------
3517  8485                      MACRO emit_sort_code
3518  8485 ~            sort_loaded_dir
3519  8485 ~                    ld hl,ALLFILES
3520  8485 ~                    call ROZHOD2
3521  8485 ~                    ld a,(hl)                                ; katalog má nejvýše pocetpolozek (200)
3522  8485 ~                    cp 2
3523  8485 ~                    ret c
3524  8485 ~                    ld (sortEnd),a
3525  8485 ~
3526  8485 ~                    xor a
