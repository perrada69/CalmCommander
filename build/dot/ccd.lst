 198  7103                                                                ; ReadNextReg2A
 199  7103                                                                ; ------------------------------------------------------------
 200  7103                                                                ; Vstup:
 201  7103                                                                ; A = číslo NextReg (index)
 202  7103                                                                ; Výstup:
 203  7103                                                                ; A = přečtená hodnota NextReg
 204  7103                                                                ; Pozn:
 205  7103                                                                ; Funkce mění aktuálně vybraný NextReg na portu (out na 243B/253B).
 206  7103                                                                ; ------------------------------------------------------------
 207  7103              ReadNextReg2A:
 208  7103 C5                       push    bc
 209  7104 01 3B 24                 ld      bc,#243B                      ; TBBlue register select port
 210  7107 ED 79                    out     (c),a                         ; zvol NextReg index
 211  7109 04                       inc     b                             ; BC = #253B (register access port)
 212  710A ED 78                    in      a,(c)                         ; načti hodnotu zvoleného NextReg
 213  710C C1                       pop     bc
 214  710D C9                       ret
