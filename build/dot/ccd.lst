3626  8485 ~                    ld b,a
3627  8485 ~                    ld a,(sortOuter)
3628  8485 ~                    cp b
3629  8485 ~                    call nz,sort_swap_items
3630  8485 ~                    ld hl,sortOuter
3631  8485 ~                    inc (hl)
3632  8485 ~                    jr .outer
3633  8485 ~
3634  8485 ~            ; C=1 pokud LFNNAME (candidate) patří před LFNNAME2 (best)
3635  8485 ~            sort_candidate_before_best
