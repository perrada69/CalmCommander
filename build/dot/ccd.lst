 230+ 99A8 7E           por0    ld a,(hl)
 231+ 99A9 2B                   dec hl
 232+ 99AA FE 20                cp 32
 233+ 99AC 28 FA                jr z,por0                    ; přeskakuj mezery na konci
 234+ 99AE 23                   inc hl                       ; vrať se na poslední znak (nebo o 1 zpět dle struktury)
 235+ 99AF 23                   inc hl
 236+ 99B0 36 FF                ld (hl),255                  ; sentinel za poslední znak
 237+ 99B2 23                   inc hl
 238+ 99B3 AF                   xor a
 239+ 99B4 77                   ld (hl),a                    ; ještě 0 za sentinel (dvojité ukončení)
 240+ 99B5
 241+ 99B5                      ;--- uprav konec LFNNAME2 -----------------------------------------------
 242+ 99B5 21 DC 9E             ld hl,LFNNAME2+260
 243+ 99B8 7E           por1    ld a,(hl)
 244+ 99B9 2B                   dec hl
 245+ 99BA FE 20                cp 32
 246+ 99BC 28 FA                jr z,por1
 247+ 99BE 23                   inc hl
 248+ 99BF 23                   inc hl
 249+ 99C0 36 FF                ld (hl),255
 250+ 99C2 23                   inc hl
 251+ 99C3 AF                   xor a
 252+ 99C4 77                   ld (hl),a
