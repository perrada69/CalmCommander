 246+ 99BC 28 FA                jr z,por1
 247+ 99BE 23                   inc hl
 248+ 99BF 23                   inc hl
 249+ 99C0 36 FF                ld (hl),255
 250+ 99C2 23                   inc hl
 251+ 99C3 AF                   xor a
 252+ 99C4 77                   ld (hl),a
