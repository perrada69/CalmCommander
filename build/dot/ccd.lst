 306+ 99E4 CD 65 7F             call find83                  ; načti 8.3 data
 307+ 99E7 E1                   pop hl
 308+ 99E8 E5                   push hl
 309+ 99E9 2B                   dec hl
 310+ 99EA CD AE D1             call FINDLFN                 ; načti LFN do LFNNAME
 311+ 99ED
