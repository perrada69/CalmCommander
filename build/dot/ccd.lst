 271+ 99D1              ;------------------------------------------------------------------------------
 272+ 99D1              ; compare.deselect
 273+ 99D1              ;------------------------------------------------------------------------------
 274+ 99D1              ; Zruší označení (výběr/shody) u všech souborů v aktuálním panelu.
 275+ 99D1              ;
 276+ 99D1              ; Jak to funguje:
 277+ 99D1              ;   - Projde všechny položky v ALLFILES (přes ROZHOD2 dle OKNO).
 278+ 99D1              ;   - Pro každou položku:
 279+ 99D1              ;       * načte 8.3 záznam (BUFF83 + find83)
 280+ 99D1              ;       * načte LFN (FINDLFN) do LFNNAME
 281+ 99D1              ;       * připraví dva řetězce pro search:
 282+ 99D1              ;           - v RAM na adrese 23296 je zřejmě pracovní buffer pro "hledaný text"
 283+ 99D1              ;           - do (23296) se patrně BUFF83/find83 uloží i 8.3 jméno, nebo se to
 284+ 99D1              ;             používá jako "search key"
 285+ 99D1              ;           - LFNNAME je druhý řetězec
 286+ 99D1              ;         Oba řetězce se ukončí sentinel 255 za posledním znakem (ořez trailing spaces).
 287+ 99D1              ;       * search(de=23296, hl=LFNNAME) -> nastaví (foundfile) pokud našel.
 288+ 99D1              ;       * Pokud našel (NZ=0?), vezme (foundfile), zavolá BUFF83 a udělá res 7,(hl)
 289+ 99D1              ;         => odstraní "označeno" (bit 7 flagu).
 290+ 99D1              ;       * Následně nulováním dvou bajtů někde u numsel (asi počitadlo vybraných)
 291+ 99D1              ;         resetuje počty výběrů pro panel.
 292+ 99D1              deselect
 293+ 99D1 3E FF                ld a,255
 294+ 99D3 32 00 5B             ld (23296),a                 ; inicializace/terminátor pracovního bufferu
 295+ 99D6
 296+ 99D6 21 4F 87             ld hl,ALLFILES
 297+ 99D9 CD 50 7F             call ROZHOD2
 298+ 99DC 7E                   ld a,(hl)
 299+ 99DD 23                   inc hl
 300+ 99DE 66                   ld h,(hl)
 301+ 99DF 6F                   ld l,a                       ; HL = iterátor přes položky v aktuálním panelu
 302+ 99E0
 303+ 99E0              ;--- smyčka přes všechny soubory ----------------------------------------------
 304+ 99E0 E5           dfind0   push hl
