 377+ 9C88              ; $C000; placing it beside settings_open ($DDxx) makes the DOS open read
 378+ 9C88              ; unrelated bank-7 data and the dialog then fails silently.
 379+ 9C88 73 65 74 74  settingsPluginName defb "settings.ccp",255
 379+ 9C8C 69 6E 67 73
 379+ 9C90 2E 63 63 70
 379+ 9C94 FF
 380+ 9C95                      assert settingsPluginName < $C000
 381+ 9C95
 382+ 9C95              ; settings_open itself lives in the banked $C000-$DFFF area. It must not
 383+ 9C95              ; regain control between dospage and basicpage, because dospage maps that
 384+ 9C95              ; code out. Keep the complete configuration write transition resident here.
 385+ 9C95              settings_save_config
 386+ 9C95 CD 83 83             call dospage
 387+ 9C98 CD 68 86             call zapisCfg
 388+ 9C9B CD 93 83             call basicpage
 389+ 9C9E C9                   ret
 390+ 9C9F                      assert settings_save_config < $C000
