8483  E3E7              ; ------------------------------------------------------------
8484  E3E7              ; extra_dot_basic_cmd - prikaz BASICu pro spusteni souboru z cmd2
8485  E3E7              ; ------------------------------------------------------------
8486  E3E7              ; Dot command BASIC program spustit nemuze (.run jen vypise navod), ale
8487  E3E7              ; BASIC po navratu z .cc pokracuje zbytkem radku. Zavadec proto po
8488  E3E7              ; obnoveni pameti vlozi tenhle prikaz za .cc. Prikazy jsou stejne jako
8489  E3E7              ; v c:/nextzxos/browser.cfg; cisla nesou skryty 5bajtovy tvar ($0E ...),
8490  E3E7              ; ktery BASIC pri behu cte misto cislic.
8491  E3E7              ; Vystup: dot_cmd_buf = [delka][priznaky][tokeny], NZ = pripraveno, Z = NEX.
8492  E3E7              ; Priznaky (prvni bajt sablony): bit 0 = spustit na 3,5 MHz (TAP, snapshoty
8493  E3E7              ; jako v BASIC verzi; BAS zustava na rychlosti uzivatele jako v Browseru).
8494  E3E7              ; ------------------------------------------------------------
8495  E3E7              DOTC_NAME       equ $1F                           ; v sablone: sem jmeno souboru
8496  E3E7              DOTC_END        equ $1E                           ; v sablone: konec
8497  E3E7              DOTC_MACH       equ $1D                           ; v sablone: tabComp[cursorComp]
8498  E3E7
8499  E3E7              extra_dot_basic_cmd:
8500  E3E7 21 C4 7B                 ld hl,cmd2                            ; najdi konec jmena
8501  E3EA 01 3D 00                 ld bc,61
8502  E3ED AF                       xor a
8503  E3EE ED B1                    cpir
8504  E3F0 2B                       dec hl
8505  E3F1 2B                       dec hl
8506  E3F2 7E                       ld a,(hl)                             ; pripona malymi pismeny do C,D,E
8507  E3F3 F6 20                    or $20
8508  E3F5 5F                       ld e,a
8509  E3F6 2B                       dec hl
8510  E3F7 7E                       ld a,(hl)
8511  E3F8 F6 20                    or $20
8512  E3FA 57                       ld d,a
8513  E3FB 2B                       dec hl
8514  E3FC 7E                       ld a,(hl)
8515  E3FD F6 20                    or $20
8516  E3FF 4F                       ld c,a
8517  E400 21 80 E4                 ld hl,extraDotTypes
