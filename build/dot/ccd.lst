6734  CC66              ; TAP: stejne jako RUN_TAP v BASIC verzi potvrzeni a vyber pocitace
6735  CC66              ; (vyberPocitace nastavi typ pocitace a turbo, pri zruseni skace na loop0).
6736  CC66              ; Prikaz pro BASIC pak podle cursorComp slozi extra_dot_basic_cmd.
6737  CC66              dot_run_tap
