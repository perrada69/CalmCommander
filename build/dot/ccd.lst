2752  8031                      ; Fyzický scanner klávesnice.
2753  8031                      ; OUT: D=$27 CAPS SHIFT, D=$18 SYMBOL SHIFT, jinak D=$FF.
2754  8031                      ;      E=index 0..38 do SYMTAB/CAPSTAB/NORMTAB, nebo $FF bez klávesy.
2755  8031                      ; Modifier se čte samostatně a při procházení 38 běžných kláves se
2756  8031                      ; jeho vlastní maticový bit vynechá. Všechny kombinace CAPS/SYMBOL
2757  8031                      ; tak používají stejnou obecnou cestu bez speciálních výjimek.
2758  8031 11 FF FF     KEYSCAN  ld   de,$ffff
2759  8034 01 FE FE              ld   bc,$fefe                            ; CAPS SHIFT, Z, X, C, V
2760  8037 ED 78                 in   a,(c)
2761  8039 1F                    rra                                       ; CAPS SHIFT = bit 0 aktivní v nule
2762  803A 38 04                 jr   c,.check_symbol
2763  803C 16 27                 ld   d,$27
2764  803E 18 0A                 jr   .scan_init
2765  8040              .check_symbol
2766  8040 06 7F                 ld   b,$7f                               ; SPACE, SYMBOL SHIFT, M, N, B
2767  8042 ED 78                 in   a,(c)
2768  8044 CB 4F                 bit  1,a
2769  8046 20 02                 jr   nz,.scan_init
2770  8048 16 18                 ld   d,$18
2771  804A              .scan_init
2772  804A 2E 2F                 ld   l,47                                ; základ kódu pro první půlřádek
2773  804C 06 FE                 ld   b,$fe                               ; C zůstává $FE
2774  804E              .row
2775  804E ED 78                 in   a,(c)
2776  8050 2F                    cpl
2777  8051 E6 1F                 and  31
2778  8053 67                    ld   h,a
2779  8054 7D                    ld   a,l
