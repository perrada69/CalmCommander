  15  0000
  16  0000                          ; Pevné 8K stránky CC. Všechny jsou pod 96, aby CC běžel i na 1MB
  17  0000                          ; Nextu (ten má stránky 0-95). NextZXOS přiděluje stránky shora,
  18  0000                          ; proto jsou nejvyšší stránky (88-95 kromě extra banky) volné.
  19  0000                          ;   24-43   LFN levého panelu (lfnpage), 20 stránek = 597 položek
  20  0000                          ;   44-63   LFN pravého panelu
  21  0000                          ;   64-69   Layer 2 pluginů NXI/SCR (16K banky 32-34, VIEW_L2_BANK)
  22  0000                          ;   70      pracovní stránka syscopy/dir_info/bookmarks/settings
  23  0000                          ;           (SYS_COPY_WORK_PAGE; dot commandy .copy/.del/.dirinfo i 71)
  24  0000                          ;   72      pomocný katalog v getdir
  25  0000                          ;   74, 76  katalog levého/pravého panelu (buffl/buffr)
  26  0000                          ;   78      savescr
  27  0000                          ;   73, 75, 77, 79, 81, 83, 85, 87  data prohlížeče (viewDataPages)
  28  0000                          ;   82      plugin prohlížeče a syscopy
  29  0000                          ;   90      extra banka (cc.bas: LOAD "cc_xb.bin" BANK 45)
  30  0000                          ; Zavaděč .cc rezervuje přesně tyto stránky (fixedRanges v dot/ccdot.asm).
  31  0000
  32  0000                          ; CC_DOT (sjasmplus -DCC_DOT) sestavi variantu pro dot command .cc
  33  0000                          ; (zavadec je v dot/ccdot.asm). Pluginy pak hleda v c:/sys/cc.
  34  0000                          IFDEF CC_DOT
  35  0000                          DEFINE PLUGIN_DIR       "c:/sys/cc"
  36  0000                          ELSE
  37  0000 ~                        DEFINE PLUGIN_DIR       "c:/CalmCommander/plugin"
  38  0000                          ENDIF
