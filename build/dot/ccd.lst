4470  9ED2 CD 0F 01             call $010F              ; DOS_REF_HEAD: IX = pointer to 8-byte header
4471  9ED5 D0                   ret nc                  ; propagate failure (should never occur)
4472  9ED6 3A 31 BB             ld a,(viewPluginContext+VIEWCTX_P3DOS_TYPE)
4473  9ED9 DD 77 00             ld (ix+0),a             ; type (0=BASIC, 3=CODE, etc.)
