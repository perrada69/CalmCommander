 345+ A935              ; ZjistiJestliJsemVMenu
 346+ A935              ;
 347+ A935              ; Rutina zjistí parametry aktuálně aktivního menu a připraví oblast,
 348+ A935              ; ve které se menu nachází, pro další zpracování (např. detekci kurzoru).
 349+ A935              ;
 350+ A935              ; Postup:
 351+ A935              ;   1) Podle indexu menu (nummenu) zjistí počet položek menu
 352+ A935              ;      z tabulky menulenght.
 353+ A935              ;   2) Z tabulky menupos načte X souřadnici menu.
 354+ A935              ;   3) Spočítá horizontální rozsah menu (levý a pravý okraj).
 355+ A935              ;   4) Podle počtu položek spočítá vertikální rozsah menu
 356+ A935              ;      (výška menu = počet položek × 8).
 357+ A935              ;   5) Připraví hodnoty pro rutinu CONTROL, která následně testuje,
 358+ A935              ;      zda se kurzor nachází v oblasti menu.
 359+ A935              ;
 360+ A935              ; Výstupy ukládá do:
 361+ A935              ;   xovaSouradniceMenu  - levý okraj menu
 362+ A935              ;   konecXoveSouradnice - pravý okraj menu
 363+ A935              ;   rohAktivnihoMenu    - spodní hranice / výška menu
 364+ A935              ;
 365+ A935              ; Používá self-modifying kód pro předání počtu položek.
 366+ A935              ;
 367+ A935              ; Volá:
 368+ A935              ;   CONTROL
 369+ A935              ;
 370+ A935              ; Registry: A, DE, HL modifikovány.
 371+ A935              ; -----------------------------------------------------------------------------
 372+ A935              ZjistiJestliJsemVMenu
 373+ A935 3A 5D AB             ld a,(nummenu)          ; A = číslo aktuálního menu (index)
 374+ A938 5F                   ld e,a                  ; E = index menu
 375+ A939 16 00                ld d,0                  ; DE = index (16-bit), D=0
 376+ A93B
 377+ A93B 21 68 AB             ld hl,menulenght        ; HL = base adresa tabulky délek menu
 378+ A93E 19                   add hl,de               ; HL = menulenght + index
 379+ A93F 7E                   ld a,(hl)               ; A = menulenght[index]  (pravděpodobně "počet položek - 1" nebo podobně)
 380+ A940 3C                   inc a                   ; A = počet položek aktivního menu (dorovnání +1)
 381+ A941
 382+ A941 32 58 A9             ld (pocetPolozekMenu + 1),a ; self-modifying: přepíše operand u "ld e,0" níže na aktuální počet položek
 383+ A944
 384+ A944 21 58 AB             ld hl,menupos           ; HL = base tabulky X pozic menu
 385+ A947 19                   add hl,de               ; HL = menupos + index
 386+ A948 7E                   ld a,(hl)               ; A = menupos[index] = X souřadnice menu (asi v pixelech nebo sloupcích)
 387+ A949 B7                   or a                    ; test A==0 ?
 388+ A94A 28 02                jr z,nultaPolozka       ; pokud X=0, neskákej do posunů (nech 0)
 389+ A94C
 390+ A94C 3D                   dec a                   ; jinak X -= 2  (posun vlevo)
 391+ A94D 3D                   dec a
 392+ A94E
 393+ A94E              nultaPolozka                    ; zde se definuje obdélník aktivního menu (X rozsah)
 394+ A94E 32 D8 A9             ld (xovaSouradniceMenu),a   ; uloží levý okraj menu
 395+ A951
 396+ A951 06 24                ld b,36                 ; šířka menu (nebo delta do pravého okraje) = 36
 397+ A953 80                   add a,b                 ; A = X + 36
 398+ A954 32 DA A9             ld (konecXoveSouradnice),a  ; uloží pravý okraj menu
 399+ A957
 400+ A957              pocetPolozekMenu
 401+ A957 1E 00                ld e,0                  ; !!! operand "0" je před chvílí přepsán -> E = počet položek
 402+ A959 16 08                ld d,8                  ; D = 8 (výška jedné položky v pixelech / řádcích)
 403+ A95B ED 30                mul d,e                 ; DE = D*E (na klasickém Z80 není MUL, tohle je Z80N / makro / assembler rozšíření)
 404+ A95D                                              ; výsledkem chceš mít v E celkovou výšku menu (8 * počet položek)
 405+ A95D
 406+ A95D 7B                   ld a,e                  ; A = výška (v 8px krocích) v E
 407+ A95E 3D                   dec a                   ; A -= 2 (zase korekce: "roh" obdélníku trochu nahoru)
 408+ A95F 3D                   dec a
 409+ A960 32 DB A9             ld (rohAktivnihoMenu),a ; uloží "roh" (pravděpodobně Y rozsah / výšku / spodní okraj)
 410+ A963
 411+ A963 21 D8 A9             ld hl,xovaSouradniceMenu ; HL ukazuje na strukturu/parametry obdélníku (minimálně X start)
 412+ A966 CD 71 A7             call CONTROL
