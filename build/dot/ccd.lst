 481+ A9B4              ; podbarviPodlePoziceMysky
 482+ A9B4              ; "Hover" logika: pokud je menu zobrazené a myš je uvnitř jeho oblasti,
 483+ A9B4              ; tak se podle Y souřadnice myši přepne vybraná položka (kurzor) a podbarví se.
 484+ A9B4              ;
 485+ A9B4              ; Používá:
 486+ A9B4              ;   - zobrazeneMenu: 0/1 (menu aktivní)
 487+ A9B4              ;   - ZjistiJestliJsemVMenu: připraví bounding box + volá CONTROL
 488+ A9B4              ;     Výstup: C = mimo menu, NC = uvnitř menu
 489+ A9B4              ;   - COORD+1: Y souřadnice myši
 490+ A9B4              ;   - deleno8: vydělí Y / 8 (výsledek v D) => řádek menu
 491+ A9B4              ;   - writecurmenu: vykreslení kurzoru/podbarvení (A určuje "barvu"/znak)
 492+ A9B4              ;
 493+ A9B4              ; Efekt:
 494+ A9B4              ;   - smaže staré zvýraznění (A=48)
 495+ A9B4              ;   - nastaví curmeny a menucur podle myši
 496+ A9B4              ;   - vykreslí nové zvýraznění (A=64)
 497+ A9B4              ; =============================================================================
 498+ A9B4              podbarviPodlePoziceMysky
 499+ A9B4
 500+ A9B4 3A BE A7             ld a,(zobrazeneMenu)
 501+ A9B7 B7                   or a
 502+ A9B8 C8                   ret z                   ; pokud menu není zobrazené, nic nedělej
 503+ A9B9
 504+ A9B9                      ; Hover reaguje jen na pohyb. Jinak by stojící myš po každém
 505+ A9B9                      ; stisku šipky okamžitě vrátila kurzor na svůj řádek.
 506+ A9B9 2A 84 A7             ld hl,(COORD)
 507+ A9BC ED 5B EB A9          ld de,(menuMouseCoord)
 508+ A9C0 E5                   push hl
 509+ A9C1 B7                   or a
 510+ A9C2 ED 52                sbc hl,de
 511+ A9C4 E1                   pop hl
 512+ A9C5 C8                   ret z
 513+ A9C6 22 EB A9             ld (menuMouseCoord),hl
 514+ A9C9
 515+ A9C9 CD 4A A9             call ZjistiJestliJsemVMenu
 516+ A9CC D8                   ret c                   ; Carry=1 => myš není v menu oblasti
