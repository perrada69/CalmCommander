 718+ AA62 21 00 00     curmen   ld hl,0                ; SMC: base adresa menu v obrazovce
 719+ AA65 1E 01        curmeny  ld e,1                 ; SMC: E = řádek kurzoru
 720+ AA67 16 A0                ld d,160
 721+ AA69 ED 30                mul d,e                 ; DE = 160 * E
 722+ AA6B 19                   add hl,de               ; HL = base + rowOffset
 723+ AA6C 23                   inc hl
