 214  7103                                                                ; ReadNextReg2A
 215  7103                                                                ; ------------------------------------------------------------
 216  7103                                                                ; Vstup:
 217  7103                                                                ; A = číslo NextReg (index)
 218  7103                                                                ; Výstup:
 219  7103                                                                ; A = přečtená hodnota NextReg
 220  7103                                                                ; Pozn:
 221  7103                                                                ; Funkce mění aktuálně vybraný NextReg na portu (out na 243B/253B).
 222  7103                                                                ; ------------------------------------------------------------
 223  7103              ReadNextReg2A:
 224  7103 C5                       push    bc
 225  7104 01 3B 24                 ld      bc,#243B                      ; TBBlue register select port
 226  7107 ED 79                    out     (c),a                         ; zvol NextReg index
 227  7109 04                       inc     b                             ; BC = #253B (register access port)
 228  710A ED 78                    in      a,(c)                         ; načti hodnotu zvoleného NextReg
 229  710C C1                       pop     bc
 230  710D C9                       ret
