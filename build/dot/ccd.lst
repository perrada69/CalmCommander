 452+ A995 FE 38                cp 56                   ; 46..55
 453+ A997 38 13                jr c,.RET3
 454+ A999
 455+ A999 FE 47                cp 71                   ; 56..70
 456+ A99B 38 13                jr c,.RET4
 457+ A99D
 458+ A99D              .NO_HIT
 459+ A99D 3E FF                ld a,255
 460+ A99F 37                   scf                     ; C=1 netrefil
 461+ A9A0 C9                   ret
 462+ A9A1
 463+ A9A1 AF           .RET0    xor a                  ; A=0
 464+ A9A2 B7                    or a                   ; C=0
 465+ A9A3 C9                    ret
 466+ A9A4 3E 01        .RET1    ld a,1
 467+ A9A6 B7                    or a
 468+ A9A7 C9                    ret
 469+ A9A8 3E 02        .RET2    ld a,2
 470+ A9AA B7                    or a
 471+ A9AB C9                    ret
 472+ A9AC 3E 03        .RET3    ld a,3
 473+ A9AE B7                    or a
 474+ A9AF C9                    ret
 475+ A9B0 3E 04        .RET4    ld a,4
 476+ A9B2 B7                    or a
 477+ A9B3 C9                    ret
