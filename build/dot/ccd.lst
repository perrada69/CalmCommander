 230+ 998F 7E           por0    ld a,(hl)
 231+ 9990 2B                   dec hl
 232+ 9991 FE 20                cp 32
 233+ 9993 28 FA                jr z,por0                    ; přeskakuj mezery na konci
 234+ 9995 23                   inc hl                       ; vrať se na poslední znak (nebo o 1 zpět dle struktury)
 235+ 9996 23                   inc hl
 236+ 9997 36 FF                ld (hl),255                  ; sentinel za poslední znak
 237+ 9999 23                   inc hl
 238+ 999A AF                   xor a
 239+ 999B 77                   ld (hl),a                    ; ještě 0 za sentinel (dvojité ukončení)
 240+ 999C
 241+ 999C                      ;--- uprav konec LFNNAME2 -----------------------------------------------
 242+ 999C 21 C3 9E             ld hl,LFNNAME2+260
 243+ 999F 7E           por1    ld a,(hl)
 244+ 99A0 2B                   dec hl
 245+ 99A1 FE 20                cp 32
 246+ 99A3 28 FA                jr z,por1
 247+ 99A5 23                   inc hl
 248+ 99A6 23                   inc hl
 249+ 99A7 36 FF                ld (hl),255
 250+ 99A9 23                   inc hl
 251+ 99AA AF                   xor a
 252+ 99AB 77                   ld (hl),a
 253+ 99AC
 254+ 99AC                      ;--- porovnání přes vyhledávání -----------------------------------------
 255+ 99AC 21 AC 9C             ld hl,LFNNAME
 256+ 99AF 11 BF 9D             ld de,LFNNAME2
 257+ 99B2 3E 00                ld a,0
 258+ 99B4              xcv
