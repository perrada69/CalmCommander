8477  E3E7              ; extra_dot_basic_cmd - prikaz BASICu pro spusteni souboru z cmd2
8478  E3E7              ; ------------------------------------------------------------
8479  E3E7              ; Dot command BASIC program spustit nemuze (.run jen vypise navod), ale
8480  E3E7              ; BASIC po navratu z .cc pokracuje zbytkem radku. Zavadec proto po
8481  E3E7              ; obnoveni pameti vlozi tenhle prikaz za .cc. Prikazy jsou stejne jako
8482  E3E7              ; v c:/nextzxos/browser.cfg; cisla nesou skryty 5bajtovy tvar ($0E ...),
8483  E3E7              ; ktery BASIC pri behu cte misto cislic.
8484  E3E7              ; Vystup: dot_cmd_buf = [delka][tokeny], NZ = pripraveno, Z = NEX.
8485  E3E7              ; ------------------------------------------------------------
8486  E3E7              DOTC_NAME       equ $1F                           ; v sablone: sem jmeno souboru
8487  E3E7              DOTC_END        equ $1E                           ; v sablone: konec
8488  E3E7
