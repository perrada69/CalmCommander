2768  804C                      ; Fyzický scanner klávesnice.
2769  804C                      ; OUT: D=$27 CAPS SHIFT, D=$18 SYMBOL SHIFT, jinak D=$FF.
2770  804C                      ;      E=index 0..38 do SYMTAB/CAPSTAB/NORMTAB, nebo $FF bez klávesy.
2771  804C                      ; Modifier se čte samostatně a při procházení 38 běžných kláves se
2772  804C                      ; jeho vlastní maticový bit vynechá. Všechny kombinace CAPS/SYMBOL
2773  804C                      ; tak používají stejnou obecnou cestu bez speciálních výjimek.
2774  804C 11 FF FF     KEYSCAN  ld   de,$ffff
2775  804F 01 FE FE              ld   bc,$fefe                            ; CAPS SHIFT, Z, X, C, V
2776  8052 ED 78                 in   a,(c)
2777  8054 1F                    rra                                       ; CAPS SHIFT = bit 0 aktivní v nule
2778  8055 38 04                 jr   c,.check_symbol
2779  8057 16 27                 ld   d,$27
2780  8059 18 0A                 jr   .scan_init
2781  805B              .check_symbol
2782  805B 06 7F                 ld   b,$7f                               ; SPACE, SYMBOL SHIFT, M, N, B
2783  805D ED 78                 in   a,(c)
2784  805F CB 4F                 bit  1,a
2785  8061 20 02                 jr   nz,.scan_init
2786  8063 16 18                 ld   d,$18
2787  8065              .scan_init
2788  8065 2E 2F                 ld   l,47                                ; základ kódu pro první půlřádek
2789  8067 06 FE                 ld   b,$fe                               ; C zůstává $FE
