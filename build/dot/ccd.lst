8467  E3E7              ; ------------------------------------------------------------
8468  E3E7              ; extra_dot_basic_cmd - prikaz BASICu pro spusteni souboru z cmd2
8469  E3E7              ; ------------------------------------------------------------
8470  E3E7              ; Dot command BASIC program spustit nemuze (.run jen vypise navod), ale
8471  E3E7              ; BASIC po navratu z .cc pokracuje zbytkem radku. Zavadec proto po
8472  E3E7              ; obnoveni pameti vlozi tenhle prikaz za .cc. Prikazy jsou stejne jako
8473  E3E7              ; v c:/nextzxos/browser.cfg; cisla nesou skryty 5bajtovy tvar ($0E ...),
8474  E3E7              ; ktery BASIC pri behu cte misto cislic.
8475  E3E7              ; Vystup: dot_cmd_buf = [delka][priznaky][tokeny], NZ = pripraveno, Z = NEX.
8476  E3E7              ; Priznaky (prvni bajt sablony): bit 0 = spustit na 3,5 MHz (TAP, snapshoty
8477  E3E7              ; jako v BASIC verzi; BAS zustava na rychlosti uzivatele jako v Browseru).
8478  E3E7              ; ------------------------------------------------------------
8479  E3E7              DOTC_NAME       equ $1F                           ; v sablone: sem jmeno souboru
8480  E3E7              DOTC_END        equ $1E                           ; v sablone: konec
8481  E3E7              DOTC_MACH       equ $1D                           ; v sablone: tabComp[cursorComp]
8482  E3E7
8483  E3E7              extra_dot_basic_cmd:
8484  E3E7 21 A2 7B                 ld hl,cmd2                            ; najdi konec jmena
8485  E3EA 01 3D 00                 ld bc,61
8486  E3ED AF                       xor a
8487  E3EE ED B1                    cpir
8488  E3F0 2B                       dec hl
8489  E3F1 2B                       dec hl
8490  E3F2 7E                       ld a,(hl)                             ; pripona malymi pismeny do C,D,E
8491  E3F3 F6 20                    or $20
8492  E3F5 5F                       ld e,a
8493  E3F6 2B                       dec hl
8494  E3F7 7E                       ld a,(hl)
8495  E3F8 F6 20                    or $20
8496  E3FA 57                       ld d,a
8497  E3FB 2B                       dec hl
8498  E3FC 7E                       ld a,(hl)
8499  E3FD F6 20                    or $20
8500  E3FF 4F                       ld c,a
8501  E400 21 80 E4                 ld hl,extraDotTypes
8502  E403              .find
8503  E403 7E                       ld a,(hl)
8504  E404 B7                       or a
8505  E405 28 16                    jr z,.found                           ; konec tabulky: SNA/Z80
8506  E407 B9                       cp c
8507  E408 20 0C                    jr nz,.skip
8508  E40A 23                       inc hl
8509  E40B 7E                       ld a,(hl)
