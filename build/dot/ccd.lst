 736+ AA8D              ; menuenter / MENUENTER
 737+ AA8D              ; Provede akci vybrané položky menu:
 738+ AA8D              ;   1) Najde adresu definice menu (menuitems + 2*nummenu)
 739+ AA8D              ;   2) Najde v něm položku podle menucur:
 740+ AA8D              ;        položka = menucur+1 (proto inc a)
 741+ AA8D              ;        offset = 22 * položka (proto d=22) - pak -2 (dec de, dec de)
 742+ AA8D              ;      (Tj. očekávám fixní délku záznamu položky v menu definici!)
 743+ AA8D              ;   3) Z definice položky načte handler adresu (defw) a skočí na ni.
 744+ AA8D              ;   4) Před skokem schová menu:
 745+ AA8D              ;        - zobrazeneMenu=0
 746+ AA8D              ;        - loadscr (obnoví původní screen)
 747+ AA8D              ; =============================================================================
 748+ AA8D              MENUENTER
 749+ AA8D              menuenter
 750+ AA8D                      ; Poslední položka Utils je jediná "živá" položka menu:
 751+ AA8D                      ; cykluje hodnotu a menu nezavírá.
 752+ AA8D 3A 72 AB             ld a,(nummenu)
 753+ AA90 FE 02                cp 2
 754+ AA92 20 08                jr nz,menuenter_close
 755+ AA94 3A 82 AB             ld a,(menucur)
 756+ AA97 FE 05                cp 5
 757+ AA99 CA 94 AD             jp z,cycle_sort_mode
