4811  AEAA                      include "functions/viewer.asm"
# file opened: functions/viewer.asm
   1+ AEAA              ; ============================================================
   2+ AEAA              ; Modular file viewer loader.
   3+ AEAA              ; CC only prepares a context, loads data and loads an external
   4+ AEAA              ; plugin from plugin/*.ccp. The plugin runs at $C000 and sees
   5+ AEAA              ; file data at $E000.
   6+ AEAA              ; ============================================================
   7+ AEAA
   8+ AEAA              VIEW_DATA_BANK       equ 40
   9+ AEAA              VIEW_PLUGIN_BANK     equ 41
  10+ AEAA              VIEW_DATA_PAGE       equ VIEW_DATA_BANK*2+1
  11+ AEAA              VIEW_PLUGIN_PAGE     equ VIEW_PLUGIN_BANK*2
  12+ AEAA              VIEW_PLUGIN_ABI      equ 1
  13+ AEAA              VIEW_PLUGIN_ADDRESS  equ 49152
  14+ AEAA              VIEW_DATA_ADDRESS    equ 57344
  15+ AEAA              VIEW_TEXT_MAX_READ   equ 8192
  16+ AEAA              VIEW_PLUGIN_MAX_SIZE equ 4096
  17+ AEAA              ; The plugin page is 8K, so a plugin that cannot live inside 4096 bytes may
  18+ AEAA              ; ask for the whole of it. The ZIP viewer does: an inflate engine will not
  19+ AEAA              ; fit next to the archive listing.
  20+ AEAA              VIEW_PLUGIN_BIG_SIZE equ 8192
  21+ AEAA              VIEW_DATA_MAX_PAGES  equ 8
  22+ AEAA
  23+ AEAA              ; PluginContext offsets
  24+ AEAA              VIEWCTX_ABI          equ 0
  25+ AEAA              VIEWCTX_TYPE         equ 1
  26+ AEAA              VIEWCTX_FILENAME     equ 2
  27+ AEAA              VIEWCTX_SIZE_LO      equ 4
  28+ AEAA              VIEWCTX_SIZE_HI      equ 6
  29+ AEAA              VIEWCTX_DATA_PAGE    equ 8
  30+ AEAA              VIEWCTX_DATA_ADDR    equ 9
  31+ AEAA              VIEWCTX_READ_LEN     equ 11
  32+ AEAA              VIEWCTX_PAGE_COUNT   equ 13
  33+ AEAA              VIEWCTX_DATA_PAGES   equ 14
  34+ AEAA              VIEWCTX_SERVICES     equ 16
  35+ AEAA              VIEWCTX_CURPATH      equ 18   ; pointer to active panel path string
  36+ AEAA              VIEWCTX_EXTRACT_FLAG equ 20
  37+ AEAA              VIEWCTX_EXTRACT_OFF  equ 21
  38+ AEAA              VIEWCTX_EXTRACT_CNT  equ 23
  39+ AEAA              VIEWCTX_EXTRACT_NAME equ 25   ; 16 bytes, 0/255 terminated
  40+ AEAA              VIEWCTX_DIRTY        equ 40
  41+ AEAA              VIEWCTX_P3DOS_TYPE   equ 41    ; 1 byte: $FF=no header, else TAP type (0=BASIC,1=NumArr,2=StrArr,3=Code)
  42+ AEAA              VIEWCTX_P3DOS_P1     equ 42    ; 2 bytes: TAP param1
  43+ AEAA              VIEWCTX_P3DOS_P2     equ 44    ; 2 bytes: TAP param2
  44+ AEAA              VIEWCTX_EXTRACT_OFHI equ 46    ; 2 bytes: bits 16-31 of the source offset
  45+ AEAA                                             ; (SERVICE_EXTRACT_SEEK only; bits 0-15 come in DE)
  46+ AEAA              VIEWCTX_SIZE         equ 48
  47+ AEAA
