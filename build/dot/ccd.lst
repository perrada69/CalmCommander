3605  8485 ~                    cp b
3606  8485 ~                    jr z,.selected
3607  8485 ~
3608  8485 ~                    ld a,b
3609  8485 ~                    ld de,LFNNAME
3610  8485 ~                    call sort_load_lfn
3611  8485 ~                    call sort_candidate_before_best
3612  8485 ~                    jr nc,.next_candidate
3613  8485 ~                    ld a,(sortCandidate)
3614  8485 ~                    ld (sortBest),a
3615  8485 ~                    ld hl,LFNNAME
3616  8485 ~                    ld de,LFNNAME2
3617  8485 ~                    ld bc,maxlen
3618  8485 ~                    ldir
3619  8485 ~            .next_candidate
