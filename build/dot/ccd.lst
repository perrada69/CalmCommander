3572  8485 ~                    ld a,(sortRangeEnd)
3573  8485 ~                    cp b
3574  8485 ~                    ret c
3575  8485 ~                    ret z
3576  8485 ~
3577  8485 ~                    ld a,(sortOuter)
3578  8485 ~                    ld (sortBest),a
3579  8485 ~                    ld de,LFNNAME2
3580  8485 ~                    call sort_load_lfn
