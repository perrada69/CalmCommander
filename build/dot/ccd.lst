6697  CC30              ; ------------------------------------------------------------
6698  CC30              ; Vazba na zavadec dot commandu (dot/ccdot.asm)
6699  CC30              ; ------------------------------------------------------------
6700  CC30              ; Zavadec zalohuje pamet BASICu, nahraje CC a zavola dot_entry pres
6701  CC30              ; RST $18. Navrat do zavadece = obnovit SP volajiciho a RET s A:
6702  CC30              ;   DOT_EXIT_QUIT   - obnov pamet a vrat se do BASICu
6703  CC30              ;   DOT_EXIT_LAUNCH - uvolni pamet a skoc na dot_launch (prikaz je v cmd)
6704  CC30              ; Zasobnik volajiciho lezi ve strance 1 ($E000-$FFFF), kterou CC nepise.
6705  CC30              ; ------------------------------------------------------------
6706  CC30              dot_entry
6707  CC30 ED 73 7D CC          ld (dot_basic_sp),sp
6708  CC34 31 00 71             ld sp,$7000 + 128 + 128                         ; stejne misto jako po CLEAR 28927
6709  CC37 C3 0E 71             jp START
6710  CC3A
6711  CC3A              dot_quit
6712  CC3A 3A 7F CC             ld a,(dot_attached)
6713  CC3D B7                   or a
6714  CC3E CA FE CB             jp z,softreset                            ; po nepovedenem spusteni uz neni kam se vratit
6715  CC41 CD BA 78             call layer0
6716  CC44 CD 05 7A             call ClearAllSprites
6717  CC47 FD 21 3A 5C          ld iy,23610
6718  CC4B AF                   xor a                                     ; DOT_EXIT_QUIT
6719  CC4C              ; A = DOT_EXIT_*. Kod jde i do pameti - navrat z RST $18 nemusi zachovat A.
6720  CC4C              dot_return
6721  CC4C 32 80 CC             ld (dot_exit_code),a
6722  CC4F ED 91 57 01          nextreg MMU7_E000_NR_57,1                 ; zasobnik zavadece je ve strance 1, ale CC
6723  CC53                                                                ; v MMU7 casto nechava LFN stranku (lfnroot)
6724  CC53 3E 01                ld a,1                                    ; DIAG: modry border = CC se vraci do zavadece
