   1+ AE94              ; ============================================================
   2+ AE94              ; Modular file viewer loader.
   3+ AE94              ; CC only prepares a context, loads data and loads an external
   4+ AE94              ; plugin from plugin/*.ccp. The plugin runs at $C000 and sees
   5+ AE94              ; file data at $E000.
   6+ AE94              ; ============================================================
   7+ AE94
   8+ AE94              VIEW_DATA_BANK       equ 40
   9+ AE94              VIEW_PLUGIN_BANK     equ 41
  10+ AE94              VIEW_DATA_PAGE       equ VIEW_DATA_BANK*2+1
  11+ AE94              VIEW_PLUGIN_PAGE     equ VIEW_PLUGIN_BANK*2
  12+ AE94              VIEW_PLUGIN_ABI      equ 1
  13+ AE94              VIEW_PLUGIN_ADDRESS  equ 49152
  14+ AE94              VIEW_DATA_ADDRESS    equ 57344
  15+ AE94              VIEW_TEXT_MAX_READ   equ 8192
  16+ AE94              VIEW_PLUGIN_MAX_SIZE equ 4096
  17+ AE94              ; The plugin page is 8K, so a plugin that cannot live inside 4096 bytes may
  18+ AE94              ; ask for the whole of it. The ZIP viewer does: an inflate engine will not
  19+ AE94              ; fit next to the archive listing.
  20+ AE94              VIEW_PLUGIN_BIG_SIZE equ 8192
  21+ AE94              VIEW_DATA_MAX_PAGES  equ 8
  22+ AE94
  23+ AE94              ; PluginContext offsets
  24+ AE94              VIEWCTX_ABI          equ 0
  25+ AE94              VIEWCTX_TYPE         equ 1
  26+ AE94              VIEWCTX_FILENAME     equ 2
  27+ AE94              VIEWCTX_SIZE_LO      equ 4
  28+ AE94              VIEWCTX_SIZE_HI      equ 6
  29+ AE94              VIEWCTX_DATA_PAGE    equ 8
  30+ AE94              VIEWCTX_DATA_ADDR    equ 9
  31+ AE94              VIEWCTX_READ_LEN     equ 11
  32+ AE94              VIEWCTX_PAGE_COUNT   equ 13
  33+ AE94              VIEWCTX_DATA_PAGES   equ 14
  34+ AE94              VIEWCTX_SERVICES     equ 16
  35+ AE94              VIEWCTX_CURPATH      equ 18   ; pointer to active panel path string
  36+ AE94              VIEWCTX_EXTRACT_FLAG equ 20
  37+ AE94              VIEWCTX_EXTRACT_OFF  equ 21
  38+ AE94              VIEWCTX_EXTRACT_CNT  equ 23
  39+ AE94              VIEWCTX_EXTRACT_NAME equ 25   ; 16 bytes, 0/255 terminated
  40+ AE94              VIEWCTX_DIRTY        equ 40
  41+ AE94              VIEWCTX_P3DOS_TYPE   equ 41    ; 1 byte: $FF=no header, else TAP type (0=BASIC,1=NumArr,2=StrArr,3=Code)
  42+ AE94              VIEWCTX_P3DOS_P1     equ 42    ; 2 bytes: TAP param1
  43+ AE94              VIEWCTX_P3DOS_P2     equ 44    ; 2 bytes: TAP param2
  44+ AE94              VIEWCTX_EXTRACT_OFHI equ 46    ; 2 bytes: bits 16-31 of the source offset
