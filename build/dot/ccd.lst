 767+ AA92 19                   add hl,de               ; HL = &menuitems[2*nummenu]
 768+ AA93 7E                   ld a,(hl)
 769+ AA94 23                   inc hl
 770+ AA95 66                   ld h,(hl)
 771+ AA96 6F                   ld l,a                  ; HL = adresa menu definice
 772+ AA97
 773+ AA97 E5                   push hl                 ; uložíme si base adresu menu definice
