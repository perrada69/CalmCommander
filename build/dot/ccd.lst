3546  8485 ~                    and $7f
3547  8485 ~                    cp "."
3548  8485 ~                    call NOBUFF83
3549  8485 ~                    ret nz
3550  8485 ~                    ld hl,sortStart
3551  8485 ~                    inc (hl)
3552  8485 ~                    ret
3553  8485 ~
3554  8485 ~            ; A = fyzický index položky (0 = catbuff+13), HL = ukazatel v katalogové bance
