 702+ AA5C              ; writecurmenu
 703+ AA5C              ; Vykreslí (nebo smaže) kurzor/podbarvení řádku menu.
 704+ AA5C              ;
 705+ AA5C              ; Vstup:
 706+ AA5C              ;   A = "barva" / znak / atribut, který se zapisuje (typicky 64=aktivní, 48=mazání)
 707+ AA5C              ;   curmen  (SMC) = base adresa v obrazovce (#4000 + X offset)
 708+ AA5C              ;   curmeny (SMC operand) = řádek (E) v menu, 1..N
 709+ AA5C              ;
 710+ AA5C              ; Princip:
 711+ AA5C              ;   HL = curmen + (curmeny * 160) + 1
 712+ AA5C              ;   a pak se 18× v rozestupu 2 bajty zapisuje hodnota A (atributový pruh)
 713+ AA5C              ; =============================================================================
