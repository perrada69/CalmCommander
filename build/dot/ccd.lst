 344+ A94A              ; ZjistiJestliJsemVMenu
 345+ A94A              ;
 346+ A94A              ; Rutina zjistí parametry aktuálně aktivního menu a připraví oblast,
 347+ A94A              ; ve které se menu nachází, pro další zpracování (např. detekci kurzoru).
 348+ A94A              ;
 349+ A94A              ; Postup:
 350+ A94A              ;   1) Podle indexu menu (nummenu) zjistí počet položek menu
 351+ A94A              ;      z tabulky menulenght.
 352+ A94A              ;   2) Z tabulky menupos načte X souřadnici menu.
 353+ A94A              ;   3) Spočítá horizontální rozsah menu (levý a pravý okraj).
 354+ A94A              ;   4) Podle počtu položek spočítá vertikální rozsah menu
 355+ A94A              ;      (výška menu = počet položek × 8).
 356+ A94A              ;   5) Připraví hodnoty pro rutinu CONTROL, která následně testuje,
 357+ A94A              ;      zda se kurzor nachází v oblasti menu.
 358+ A94A              ;
 359+ A94A              ; Výstupy ukládá do:
 360+ A94A              ;   xovaSouradniceMenu  - levý okraj menu
 361+ A94A              ;   konecXoveSouradnice - pravý okraj menu
 362+ A94A              ;   rohAktivnihoMenu    - spodní hranice / výška menu
 363+ A94A              ;
 364+ A94A              ; Používá self-modifying kód pro předání počtu položek.
 365+ A94A              ;
 366+ A94A              ; Volá:
 367+ A94A              ;   CONTROL
 368+ A94A              ;
 369+ A94A              ; Registry: A, DE, HL modifikovány.
 370+ A94A              ; -----------------------------------------------------------------------------
 371+ A94A              ZjistiJestliJsemVMenu
 372+ A94A 3A 72 AB             ld a,(nummenu)          ; A = číslo aktuálního menu (index)
 373+ A94D 5F                   ld e,a                  ; E = index menu
 374+ A94E 16 00                ld d,0                  ; DE = index (16-bit), D=0
 375+ A950
 376+ A950 21 7D AB             ld hl,menulenght        ; HL = base adresa tabulky délek menu
 377+ A953 19                   add hl,de               ; HL = menulenght + index
 378+ A954 7E                   ld a,(hl)               ; A = menulenght[index]  (pravděpodobně "počet položek - 1" nebo podobně)
 379+ A955 3C                   inc a                   ; A = počet položek aktivního menu (dorovnání +1)
 380+ A956
 381+ A956 32 6D A9             ld (pocetPolozekMenu + 1),a ; self-modifying: přepíše operand u "ld e,0" níže na aktuální počet položek
 382+ A959
 383+ A959 21 6D AB             ld hl,menupos           ; HL = base tabulky X pozic menu
 384+ A95C 19                   add hl,de               ; HL = menupos + index
 385+ A95D 7E                   ld a,(hl)               ; A = menupos[index] = X souřadnice menu (asi v pixelech nebo sloupcích)
 386+ A95E B7                   or a                    ; test A==0 ?
 387+ A95F 28 02                jr z,nultaPolozka       ; pokud X=0, neskákej do posunů (nech 0)
 388+ A961
 389+ A961 3D                   dec a                   ; jinak X -= 2  (posun vlevo)
 390+ A962 3D                   dec a
 391+ A963
 392+ A963              nultaPolozka                    ; zde se definuje obdélník aktivního menu (X rozsah)
 393+ A963 32 ED A9             ld (xovaSouradniceMenu),a   ; uloží levý okraj menu
 394+ A966
 395+ A966 06 24                ld b,36                 ; šířka menu (nebo delta do pravého okraje) = 36
 396+ A968 80                   add a,b                 ; A = X + 36
 397+ A969 32 EF A9             ld (konecXoveSouradnice),a  ; uloží pravý okraj menu
 398+ A96C
 399+ A96C              pocetPolozekMenu
 400+ A96C 1E 00                ld e,0                  ; !!! operand "0" je před chvílí přepsán -> E = počet položek
 401+ A96E 16 08                ld d,8                  ; D = 8 (výška jedné položky v pixelech / řádcích)
 402+ A970 ED 30                mul d,e                 ; DE = D*E (na klasickém Z80 není MUL, tohle je Z80N / makro / assembler rozšíření)
 403+ A972                                              ; výsledkem chceš mít v E celkovou výšku menu (8 * počet položek)
 404+ A972
 405+ A972 7B                   ld a,e                  ; A = výška (v 8px krocích) v E
 406+ A973 3D                   dec a                   ; A -= 2 (zase korekce: "roh" obdélníku trochu nahoru)
 407+ A974 3D                   dec a
 408+ A975 32 F0 A9             ld (rohAktivnihoMenu),a ; uloží "roh" (pravděpodobně Y rozsah / výšku / spodní okraj)
 409+ A978
 410+ A978 21 ED A9             ld hl,xovaSouradniceMenu ; HL ukazuje na strukturu/parametry obdélníku (minimálně X start)
 411+ A97B CD 89 A7             call CONTROL
 412+ A97E
 413+ A97E C9                   ret
