3638  8485 ~                    call sort_item_dot_rank
3639  8485 ~                    ld (sortTempKey),a
3640  8485 ~                    ld a,(sortBest)
3641  8485 ~                    call sort_item_dot_rank
3642  8485 ~                    ld b,a
