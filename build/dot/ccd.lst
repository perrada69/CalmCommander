8631  E501              ; Blocking keyboard input for code running in MMU7.  The resident INKEY
8632  E501              ; cannot be used here: its retry path calls gettime, and gettime changes the
8633  E501              ; $C000-$FFFF mapping through $7FFD.  Require a full release both before and
8634  E501              ; after the key so the H used to open Help is not consumed by the dialog.
8635  E501              ; The press is read with the mouse as well (kmouse/ui.a80).
8636  E501              extra_read_key:
8637  E501              .release_before
8638  E501 FB                       ei
8639  E502 76                       halt
8640  E503 CD 31 80                 call KEYSCAN
8641  E506 7B                       ld a,e
8642  E507 3C                       inc a
8643  E508 20 F7                    jr nz,.release_before
