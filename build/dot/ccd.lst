 303+ F57E              ; extra_mouse_hint - napoveda klavesy pod mysi
 304+ F57E              ; OUT: DE = kod klavesy z KEYSCAN, nebo $FFFF
 305+ F57E              ;
 306+ F57E              ; Radek tilemapy se zkopiruje do mhRow (neviditelne znaky = 0 = hranice).
 307+ F57E              ; Segment = slova oddelena jednou mezerou (dve mezery nebo ramecek ho konci).
 308+ F57E              ; Od slova pod mysi se jde doleva po segmentu a hleda se znacka klavesy:
 309+ F57E              ;   M1  "K=slovo" / "K:slovo"   (za = nebo : pismeno nebo +)   T=text, e:export
 310+ F57E              ;   M2  "K:"                    (K cislice nebo zname slovo)  5: COPY, BREAK:
 311+ F57E              ;   M3  "K ="                   (dalsi slovo je samotne =)     ENTER = yes
 312+ F57E              ;   M4  zname slovo + dalsi slovo, nebo samotne "Up/Dn"         ENTER stop
 313+ F57E              ; Segment s "any key" = ENTER. Jmeno "A/B" (Up/Dn) plati jen kliknuti primo
 314+ F57E              ; na jednu z variant.
