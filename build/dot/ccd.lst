 214+ 998C              ; porovnej_dva_lfn
 215+ 998C              ;------------------------------------------------------------------------------
 216+ 998C              ; Připraví oba LFN buffery na porovnání a zavolá specific_search.
 217+ 998C              ;
 218+ 998C              ; Co přesně dělá příprava:
 219+ 998C              ;   - Jde od konce (offset +260) směrem dozadu a přeskočí trailing mezery (0x20).
 220+ 998C              ;   - Za poslední "ne-mezeru" vloží hodnotu 255 (sentinel/terminátor).
 221+ 998C              ;   - Za to vloží 0 (pravděpodobně extra ukončení / bezpečnost pro vyhledávání).
 222+ 998C              ;
 223+ 998C              ; Pak zavolá:
 224+ 998C              ;   specific_search(LFNNAME, LFNNAME2, A=0)
 225+ 998C              ;   a vrací příznaky (Z = shoda) dál volajícímu.
 226+ 998C              ;
 227+ 998C              porovnej_dva_lfn
 228+ 998C                      ;--- uprav konec LFNNAME ------------------------------------------------
