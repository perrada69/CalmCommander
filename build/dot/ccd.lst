3573  8485 ~                    ld h,0
3574  8485 ~                    ld b,13
3575  8485 ~                    call mull
3576  8485 ~                    ld de,catbuff+13
3577  8485 ~                    add hl,de
3578  8485 ~                    call BUFF83
3579  8485 ~                    ret
3580  8485 ~
3581  8485 ~            sort_range
3582  8485 ~                    ld a,(sortStart)
3583  8485 ~                    ld (sortOuter),a
3584  8485 ~            .outer
3585  8485 ~                    ld a,(sortOuter)
3586  8485 ~                    inc a
3587  8485 ~                    ld b,a
3588  8485 ~                    ld a,(sortRangeEnd)
3589  8485 ~                    cp b
3590  8485 ~                    ret c
3591  8485 ~                    ret z
3592  8485 ~
3593  8485 ~                    ld a,(sortOuter)
3594  8485 ~                    ld (sortBest),a
3595  8485 ~                    ld de,LFNNAME2
3596  8485 ~                    call sort_load_lfn
3597  8485 ~
3598  8485 ~                    ld a,(sortOuter)
3599  8485 ~                    inc a
3600  8485 ~                    ld (sortCandidate),a
