  34+ 0000              ; Per style: background RRRGGGBB followed by foreground RRRGGGBB. The final
  35+ 0000              ; four bytes hold blue bit 0 for all 32 colours (background first).
  36+ 0000                      MACRO EMIT_SETTINGS_DEFAULT_COLOURS
  37+ 0000 ~                    db %000'000'10,%110'110'11
  38+ 0000 ~                    db %000'000'01,%111'111'11
  39+ 0000 ~                    db %000'100'11,%111'111'11
  40+ 0000 ~                    db %111'111'11,%000'000'00
  41+ 0000 ~                    db %011'101'00,%000'000'00
  42+ 0000 ~                    db %110'100'00,%000'000'00
  43+ 0000 ~                    db %100'011'00,%000'000'00
  44+ 0000 ~                    db %000'000'10,%000'111'11
  45+ 0000 ~                    db %000'000'10,%010'111'00
  46+ 0000 ~                    db %011'000'00,%101'101'11
  47+ 0000 ~                    db %000'000'01,%111'111'00
  48+ 0000 ~                    db %000'000'01,%000'111'00
  49+ 0000 ~                    db %000'000'01,%000'111'11
  50+ 0000 ~                    db %000'000'01,%000'111'00
  51+ 0000 ~                    db %000'000'01,%111'111'00
  52+ 0000 ~                    db %000'000'01,%111'000'00
  53+ 0000 ~                    db $7a,$81,$00,$02
  54+ 0000                      ENDM
  55+ 0000
  56+ 0000              ; Default INKEY code for each action, in ACT_* order. A valid binding is
  57+ 0000              ; never 0 or 1 (BREAK) and no two actions share a key.
  58+ 0000                      MACRO EMIT_SETTINGS_DEFAULT_KEYS
  59+ 0000 ~                    defb 127,10,11,9,8,4,13,"8",12,"9","0","5","6",32,"7",7
  60+ 0000 ~                    defb 6,"+","*","-","s","1","2","3","4","P","B","b","h","c","i",199
  61+ 0000 ~                    defb "S"
  62+ 0000                      ENDM
