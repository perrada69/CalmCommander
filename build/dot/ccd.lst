 482+ A99F              ; podbarviPodlePoziceMysky
 483+ A99F              ; "Hover" logika: pokud je menu zobrazené a myš je uvnitř jeho oblasti,
 484+ A99F              ; tak se podle Y souřadnice myši přepne vybraná položka (kurzor) a podbarví se.
 485+ A99F              ;
 486+ A99F              ; Používá:
 487+ A99F              ;   - zobrazeneMenu: 0/1 (menu aktivní)
 488+ A99F              ;   - ZjistiJestliJsemVMenu: připraví bounding box + volá CONTROL
 489+ A99F              ;     Výstup: C = mimo menu, NC = uvnitř menu
 490+ A99F              ;   - COORD+1: Y souřadnice myši
 491+ A99F              ;   - deleno8: vydělí Y / 8 (výsledek v D) => řádek menu
 492+ A99F              ;   - writecurmenu: vykreslení kurzoru/podbarvení (A určuje "barvu"/znak)
 493+ A99F              ;
 494+ A99F              ; Efekt:
 495+ A99F              ;   - smaže staré zvýraznění (A=48)
 496+ A99F              ;   - nastaví curmeny a menucur podle myši
 497+ A99F              ;   - vykreslí nové zvýraznění (A=64)
 498+ A99F              ; =============================================================================
 499+ A99F              podbarviPodlePoziceMysky
 500+ A99F
 501+ A99F 3A A6 A7             ld a,(zobrazeneMenu)
 502+ A9A2 B7                   or a
 503+ A9A3 C8                   ret z                   ; pokud menu není zobrazené, nic nedělej
 504+ A9A4
 505+ A9A4                      ; Hover reaguje jen na pohyb. Jinak by stojící myš po každém
 506+ A9A4                      ; stisku šipky okamžitě vrátila kurzor na svůj řádek.
 507+ A9A4 2A 6C A7             ld hl,(COORD)
 508+ A9A7 ED 5B D6 A9          ld de,(menuMouseCoord)
 509+ A9AB E5                   push hl
 510+ A9AC B7                   or a
 511+ A9AD ED 52                sbc hl,de
 512+ A9AF E1                   pop hl
 513+ A9B0 C8                   ret z
 514+ A9B1 22 D6 A9             ld (menuMouseCoord),hl
 515+ A9B4
 516+ A9B4 CD 35 A9             call ZjistiJestliJsemVMenu
 517+ A9B7 D8                   ret c                   ; Carry=1 => myš není v menu oblasti
 518+ A9B8
 519+ A9B8              JsemVMenu
 520+ A9B8                      ; --- výpočet položky v menu podle Y souřadnice myši ---
 521+ A9B8 3A 6D A7             ld a,(COORD+1)          ; A = Y souřadnice myši
