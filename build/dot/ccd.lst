 509+ A9C1 B7                   or a
 510+ A9C2 ED 52                sbc hl,de
 511+ A9C4 E1                   pop hl
 512+ A9C5 C8                   ret z
 513+ A9C6 22 EB A9             ld (menuMouseCoord),hl
 514+ A9C9
