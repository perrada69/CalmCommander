  59+ A7A2 BB                   cp e                    ; maxX - X
  60+ A7A3 38 0B                jr c,CONTROL_CLICK_NETREFIL
  61+ A7A5                                              ; pokud maxX < X → klik je vpravo mimo
  62+ A7A5
  63+ A7A5 23                   inc hl                  ; HL → maxY
  64+ A7A6
  65+ A7A6                      ; načti Y kliknutí
