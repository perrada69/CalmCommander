 214+ 998A              ; porovnej_dva_lfn
 215+ 998A              ;------------------------------------------------------------------------------
 216+ 998A              ; Připraví oba LFN buffery na porovnání a zavolá specific_search.
 217+ 998A              ;
 218+ 998A              ; Co přesně dělá příprava:
 219+ 998A              ;   - Jde od konce (offset +260) směrem dozadu a přeskočí trailing mezery (0x20).
 220+ 998A              ;   - Za poslední "ne-mezeru" vloží hodnotu 255 (sentinel/terminátor).
 221+ 998A              ;   - Za to vloží 0 (pravděpodobně extra ukončení / bezpečnost pro vyhledávání).
 222+ 998A              ;
 223+ 998A              ; Pak zavolá:
 224+ 998A              ;   specific_search(LFNNAME, LFNNAME2, A=0)
 225+ 998A              ;   a vrací příznaky (Z = shoda) dál volajícímu.
 226+ 998A              ;
 227+ 998A              porovnej_dva_lfn
 228+ 998A                      ;--- uprav konec LFNNAME ------------------------------------------------
 229+ 998A 21 AE 9D             ld hl,LFNNAME+260
 230+ 998D 7E           por0    ld a,(hl)
 231+ 998E 2B                   dec hl
 232+ 998F FE 20                cp 32
 233+ 9991 28 FA                jr z,por0                    ; přeskakuj mezery na konci
 234+ 9993 23                   inc hl                       ; vrať se na poslední znak (nebo o 1 zpět dle struktury)
 235+ 9994 23                   inc hl
 236+ 9995 36 FF                ld (hl),255                  ; sentinel za poslední znak
 237+ 9997 23                   inc hl
 238+ 9998 AF                   xor a
 239+ 9999 77                   ld (hl),a                    ; ještě 0 za sentinel (dvojité ukončení)
 240+ 999A
 241+ 999A                      ;--- uprav konec LFNNAME2 -----------------------------------------------
 242+ 999A 21 C1 9E             ld hl,LFNNAME2+260
 243+ 999D 7E           por1    ld a,(hl)
 244+ 999E 2B                   dec hl
 245+ 999F FE 20                cp 32
 246+ 99A1 28 FA                jr z,por1
 247+ 99A3 23                   inc hl
 248+ 99A4 23                   inc hl
 249+ 99A5 36 FF                ld (hl),255
 250+ 99A7 23                   inc hl
 251+ 99A8 AF                   xor a
 252+ 99A9 77                   ld (hl),a
 253+ 99AA
 254+ 99AA                      ;--- porovnání přes vyhledávání -----------------------------------------
 255+ 99AA 21 AA 9C             ld hl,LFNNAME
 256+ 99AD 11 BD 9D             ld de,LFNNAME2
 257+ 99B0 3E 00                ld a,0
 258+ 99B2              xcv
 259+ 99B2 CD F3 D2             call specific_search          ; očekává se: Z=1 pokud match (nebo dle implementace)
 260+ 99B5
 261+ 99B5
 262+ 99B5 C9                   ret
