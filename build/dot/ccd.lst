 763+ AA8A 5F                   ld e,a
 764+ AA8B 16 02                ld d,2
 765+ AA8D ED 30                mul d,e                 ; DE = 2 * nummenu
 766+ AA8F 21 5E AB             ld hl,menuitems
 767+ AA92 19                   add hl,de               ; HL = &menuitems[2*nummenu]
 768+ AA93 7E                   ld a,(hl)
 769+ AA94 23                   inc hl
 770+ AA95 66                   ld h,(hl)
 771+ AA96 6F                   ld l,a                  ; HL = adresa menu definice
 772+ AA97
 773+ AA97 E5                   push hl                 ; uložíme si base adresu menu definice
 774+ AA98
 775+ AA98                      ; --- spočítej offset na vybranou položku ---
