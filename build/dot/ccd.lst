 417+ A97F              ; GetHotXRangeInTopBands
 418+ A97F              ;
 419+ A97F              ; Test myši podle COORD (X,Y):
 420+ A97F              ;  - Y pásma: 0..8  OR  prvniYsouradniceMenu..prvniYsouradniceMenu+8
 421+ A97F              ;  - X pásma: 0..15, 16..30, 31..45, 46..55, 56..70
 422+ A97F              ;
 423+ A97F              ; Výstup:
 424+ A97F              ;   NC + A=0..4  = trefil, A je index pásma
 425+ A97F              ;   C  + A=255   = netrefil
