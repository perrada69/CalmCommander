8483  E3E7                          IFDEF CC_DOT
8484  E3E7              ; ------------------------------------------------------------
8485  E3E7              ; extra_dot_basic_cmd - prikaz BASICu pro spusteni souboru z cmd2
8486  E3E7              ; ------------------------------------------------------------
8487  E3E7              ; Dot command BASIC program spustit nemuze (.run jen vypise navod), ale
8488  E3E7              ; BASIC po navratu z .cc pokracuje zbytkem radku. Zavadec proto po
8489  E3E7              ; obnoveni pameti vlozi tenhle prikaz za .cc. Prikazy jsou stejne jako
8490  E3E7              ; v c:/nextzxos/browser.cfg; cisla nesou skryty 5bajtovy tvar ($0E ...),
8491  E3E7              ; ktery BASIC pri behu cte misto cislic.
8492  E3E7              ; Vystup: dot_cmd_buf = [delka][priznaky][tokeny], NZ = pripraveno, Z = NEX.
8493  E3E7              ; Priznaky (prvni bajt sablony): bit 0 = spustit na 3,5 MHz (TAP, snapshoty
8494  E3E7              ; jako v BASIC verzi; BAS zustava na rychlosti uzivatele jako v Browseru).
8495  E3E7              ; ------------------------------------------------------------
8496  E3E7              DOTC_NAME       equ $1F                           ; v sablone: sem jmeno souboru
8497  E3E7              DOTC_END        equ $1E                           ; v sablone: konec
8498  E3E7              DOTC_MACH       equ $1D                           ; v sablone: tabComp[cursorComp]
