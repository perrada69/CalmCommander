 701+ AA71              ; writecurmenu
 702+ AA71              ; Vykreslí (nebo smaže) kurzor/podbarvení řádku menu.
 703+ AA71              ;
 704+ AA71              ; Vstup:
 705+ AA71              ;   A = "barva" / znak / atribut, který se zapisuje (typicky 64=aktivní, 48=mazání)
 706+ AA71              ;   curmen  (SMC) = base adresa v obrazovce (#4000 + X offset)
 707+ AA71              ;   curmeny (SMC operand) = řádek (E) v menu, 1..N
 708+ AA71              ;
 709+ AA71              ; Princip:
 710+ AA71              ;   HL = curmen + (curmeny * 160) + 1
 711+ AA71              ;   a pak se 18× v rozestupu 2 bajty zapisuje hodnota A (atributový pruh)
 712+ AA71              ; =============================================================================
