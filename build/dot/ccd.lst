6687  CC30              ; Vazba na zavadec dot commandu (dot/ccdot.asm)
6688  CC30              ; ------------------------------------------------------------
6689  CC30              ; Zavadec zalohuje pamet BASICu, nahraje CC a zavola dot_entry pres
6690  CC30              ; RST $18. Navrat do zavadece = obnovit SP volajiciho a RET s A:
6691  CC30              ;   DOT_EXIT_QUIT   - obnov pamet a vrat se do BASICu
6692  CC30              ;   DOT_EXIT_LAUNCH - uvolni pamet a skoc na dot_launch (prikaz je v cmd)
6693  CC30              ; Zasobnik volajiciho lezi ve strance 1 ($E000-$FFFF), kterou CC nepise.
6694  CC30              ; ------------------------------------------------------------
6695  CC30              dot_entry
6696  CC30 ED 73 66 CC          ld (dot_basic_sp),sp
6697  CC34 31 00 71             ld sp,$7000 + 128 + 128                         ; stejne misto jako po CLEAR 28927
6698  CC37 C3 0E 71             jp START
6699  CC3A
