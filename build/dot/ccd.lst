 313+ 99ED 21 3B 5B             ld hl,23296 + 59             ; "najdi poslední znak" v pracovním bufferu
 314+ 99F0              dfind1
 315+ 99F0 2B                   dec hl
 316+ 99F1 7E                   ld a,(hl)
 317+ 99F2 FE 20                cp 32
 318+ 99F4 28 FA                jr z,dfind1                  ; přeskakuj trailing mezery
 319+ 99F6 23                   inc hl
 320+ 99F7 23                   inc hl
 321+ 99F8 3E FF                ld a,255
 322+ 99FA 77                   ld (hl),a                    ; sentinel za poslední znak
 323+ 99FB
