 435+ A982 FE 09                cp 9                    ; Y < 9  <=> Y <= 8
 436+ A984 30 17                jr nc,.NO_HIT
 437+ A986              .Y_OK
 438+ A986                      ; ---------
 439+ A986                      ; X pásma -> A = 0..4
 440+ A986                      ; ---------
 441+ A986 3A 84 A7             ld a,(COORD+0)          ; A = X
