  44+ A796 7E                   ld a,(hl)
  45+ A797 BB                   cp e                    ; minY - Y
  46+ A798 28 02                jr z,trefil             ; přesně na hraně → bereme jako zásah
  47+ A79A 30 14                jr nc,CONTROL_CLICK_NETREFIL
  48+ A79C                                              ; pokud minY > Y → klik je nad oblastí
  49+ A79C
  50+ A79C              trefil
  51+ A79C 23                   inc hl                  ; HL → maxX
  52+ A79D
  53+ A79D                      ; znovu načti X kliknutí
  54+ A79D 3A 84 A7             ld a,(COORD+0)
  55+ A7A0 5F                   ld e,a
  56+ A7A1
  57+ A7A1                      ; načti maxX oblasti
