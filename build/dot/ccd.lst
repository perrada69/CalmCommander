   1+ A771              ; -----------------------------------------------------------------------------
   2+ A771              ; CONTROL / CONTROL_CLICK
   3+ A771              ;
   4+ A771              ; Rutina kontroluje, zda aktuální souřadnice kliknutí (uložené v COORD)
   5+ A771              ; leží uvnitř obdélníku, jehož hranice jsou předány v HL.
   6+ A771              ;
   7+ A771              ; Formát dat na adrese HL:
   8+ A771              ;   +0  minX
   9+ A771              ;   +1  minY
  10+ A771              ;   +2  maxX
  11+ A771              ;   +3  maxY
  12+ A771              ;
  13+ A771              ; COORD:
  14+ A771              ;   COORD+0 = X pozice kliknutí
  15+ A771              ;   COORD+1 = Y pozice kliknutí
  16+ A771              ;
  17+ A771              ; Výstup:
  18+ A771              ;   Carry = 1  → kliknutí mimo oblast
  19+ A771              ;   Carry = 0  → kliknutí uvnitř oblasti
  20+ A771              ;
  21+ A771              ; HL je během rutiny inkrementováno.
  22+ A771              ; -----------------------------------------------------------------------------
  23+ A771
  24+ A771              CONTROL
  25+ A771              CONTROL_CLICK
  26+ A771
  27+ A771                      ; načti aktuální X souřadnici kliknutí
  28+ A771 3A 6C A7             ld a,(COORD+0)
  29+ A774 5F                   ld e,a                  ; E = X kliknutí
  30+ A775
  31+ A775                      ; načti minX oblasti
  32+ A775 7E                   ld a,(hl)
  33+ A776 BB                   cp e                    ; minX - X
  34+ A777 30 1F                jr nc,CONTROL_CLICK_NETREFIL
  35+ A779                                              ; pokud minX >= X → klik je vlevo mimo
  36+ A779
  37+ A779 23                   inc hl                  ; HL → minY
  38+ A77A
  39+ A77A                      ; načti aktuální Y kliknutí
  40+ A77A 3A 6D A7             ld a,(COORD+1)
  41+ A77D 5F                   ld e,a                  ; E = Y kliknutí
  42+ A77E
  43+ A77E                      ; načti minY oblasti
  44+ A77E 7E                   ld a,(hl)
  45+ A77F BB                   cp e                    ; minY - Y
  46+ A780 28 02                jr z,trefil             ; přesně na hraně → bereme jako zásah
  47+ A782 30 14                jr nc,CONTROL_CLICK_NETREFIL
  48+ A784                                              ; pokud minY > Y → klik je nad oblastí
  49+ A784
  50+ A784              trefil
  51+ A784 23                   inc hl                  ; HL → maxX
  52+ A785
  53+ A785                      ; znovu načti X kliknutí
  54+ A785 3A 6C A7             ld a,(COORD+0)
  55+ A788 5F                   ld e,a
  56+ A789
  57+ A789                      ; načti maxX oblasti
  58+ A789 7E                   ld a,(hl)
  59+ A78A BB                   cp e                    ; maxX - X
  60+ A78B 38 0B                jr c,CONTROL_CLICK_NETREFIL
  61+ A78D                                              ; pokud maxX < X → klik je vpravo mimo
  62+ A78D
  63+ A78D 23                   inc hl                  ; HL → maxY
  64+ A78E
  65+ A78E                      ; načti Y kliknutí
  66+ A78E 3A 6D A7             ld a,(COORD+1)
  67+ A791 5F                   ld e,a
  68+ A792
  69+ A792                      ; načti maxY oblasti
  70+ A792 7E                   ld a,(hl)
  71+ A793 BB                   cp e                    ; maxY - Y
  72+ A794 38 02                jr c,CONTROL_CLICK_NETREFIL
  73+ A796                                              ; pokud maxY < Y → klik je pod oblastí
  74+ A796
  75+ A796                      ; jsme uvnitř oblasti
  76+ A796 B7                   or a                    ; vyčistí Carry flag
  77+ A797 C9                   ret                     ; návrat s Carry=0 (zásah)
  78+ A798
  79+ A798              CONTROL_CLICK_NETREFIL
