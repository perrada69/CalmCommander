6698  CC34              ; ------------------------------------------------------------
6699  CC34              ; Vazba na zavadec dot commandu (dot/ccdot.asm)
6700  CC34              ; ------------------------------------------------------------
6701  CC34              ; Zavadec zalohuje pamet BASICu, nahraje CC a zavola dot_entry pres
6702  CC34              ; RST $18. Navrat do zavadece = obnovit SP volajiciho a RET s A:
6703  CC34              ;   DOT_EXIT_QUIT   - obnov pamet a vrat se do BASICu
6704  CC34              ;   DOT_EXIT_LAUNCH - uvolni pamet a skoc na dot_launch (prikaz je v cmd)
6705  CC34              ; Zasobnik volajiciho lezi ve strance 1 ($E000-$FFFF), kterou CC nepise.
6706  CC34              ; ------------------------------------------------------------
6707  CC34              dot_entry
6708  CC34 ED 73 86 CC          ld (dot_basic_sp),sp
6709  CC38 31 00 71             ld sp,     $7000 + 128 + 128                         ; stejne misto jako po CLEAR 28927
6710  CC3B C3 0E 71             jp START
6711  CC3E
6712  CC3E              dot_quit
6713  CC3E 3A 88 CC             ld a,(dot_attached)
6714  CC41 B7                   or a
6715  CC42 CA 02 CC             jp z,softreset                            ; po nepovedenem spusteni uz neni kam se vratit
6716  CC45 CD BA 78             call layer0
6717  CC48 CD 05 7A             call ClearAllSprites
6718  CC4B FD 21 3A 5C          ld iy,23610
6719  CC4F AF                   xor a                                     ; DOT_EXIT_QUIT
6720  CC50              ; A = DOT_EXIT_*. Kod jde i do pameti - navrat z RST $18 nemusi zachovat A.
6721  CC50              dot_return
6722  CC50 32 89 CC             ld (dot_exit_code),a
6723  CC53 ED 91 57 01          nextreg MMU7_E000_NR_57,1                 ; zasobnik zavadece je ve strance 1, ale CC
6724  CC57                                                                ; v MMU7 casto nechava LFN stranku (lfnroot)
