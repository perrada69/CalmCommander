6743  CC6F              ; ostatni (BAS/TAP/SNA/Z80/SNX) spusti az BASIC: zavadec obnovi pamet
6744  CC6F              ; a prikaz z dot_cmd_buf vlozi do radku za .cc.
6745  CC6F              dot_attached_launch
6746  CC6F CD 05 7A             call ClearAllSprites
