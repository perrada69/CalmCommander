9566  F374                      include "kmouse/ui.a80"
# file opened: kmouse/ui.a80
   1+ F374              ; =============================================================================
   2+ F374              ; Ovladani mysi v dialozich, menu a pluginech (extra banka, MMU7)
   3+ F374              ; =============================================================================
   4+ F374              ; Spolecna pravidla pro vsechna mista, kde CC ceka na klavesu:
   5+ F374              ;   - prave tlacitko = BREAK (zavrit / zrusit),
   6+ F374              ;   - kolecko        = sipka dolu / nahoru,
   7+ F374              ;   - leve tlacitko na napovede klavesy = stisk te klavesy.
   8+ F374              ; Napoveda se cte primo z tilemapy pod kurzorem, takze funguje kazdy dialog,
   9+ F374              ; ktery svoje klavesy vypisuje, bez vlastniho kodu pro mys:
  10+ F374              ;   "ENTER = yes"  "BREAK: close this window"  "5: COPY"  "[ ENTER close ]"
  11+ F374              ;   "ENTER stop"  "T=text"  "e:export"  "CAPS+e:export all"  "Up/Dn"
  12+ F374              ;   "Press any key"
  13+ F374              ; V hlavni smycce zustava puvodni obsluha panelu (klik vybira, dvojklik
  14+ F374              ; spousti, prave tlacitko oznacuje, kolecko posouva); preklada se jen spodni
  15+ F374              ; radek s funkcemi. V otevrenem menu ma klik na polozku vlastni obsluhu.
  16+ F374              ;
  17+ F374              ; Kod se vola i ze settings, bookmarks a prohlizecu, kdy v MMU6 neni cast 2
  18+ F374              ; CC. Proto nevola showSprite ani nic jineho z $C000-$DFFF; kurzor si
  19+ F374              ; prekresli sam (extra_mouse_sprite).
  20+ F374              ; =============================================================================
  21+ F374
  22+ F374              MOUSE_CTX_DIALOG equ 0
  23+ F374              MOUSE_CTX_MAIN   equ 1
  24+ F374              MOUSE_CTX_PLUGIN equ 2
  25+ F374              MOUSE_NO_KEY     equ $FFFF                ; DE: mys nedala zadnou klavesu
  26+ F374              MOUSE_HINT_TOP   equ 3*8                  ; pluginy: napovedy jen nad timto Y
  27+ F374              MOUSE_HINT_BOTTOM equ 29*8                ; a od tohoto Y (hlavni smycka jen tady)
  28+ F374
  29+ F374              ; -----------------------------------------------------------------------------
  30+ F374              ; EXTRA_MOUSE_INKEY - udalost mysi v INKEY / InkeyNoWait (clickMouse)
  31+ F374              ; IN : DE = adresa, kam se INKEY vrati (rozlisi hlavni smycku)
  32+ F374              ; OUT: A = klavesa, nebo 0 = udalost nechat volajicimu (TLACITKO zustava)
  33+ F374              ; -----------------------------------------------------------------------------
  34+ F374              EXTRA_MOUSE_INKEY:
  35+ F374 21 08 73             ld hl,loop0_inkey_ret
  36+ F377 B7                   or a
  37+ F378 ED 52                sbc hl,de
  38+ F37A 0E 01                ld c,MOUSE_CTX_MAIN
  39+ F37C 28 02                jr z,.context
  40+ F37E 0E 00                ld c,MOUSE_CTX_DIALOG
  41+ F380              .context
  42+ F380 3A 4E 73             ld a,(TLACITKO)
  43+ F383 47                   ld b,a
  44+ F384 79                   ld a,c
  45+ F385 C3 EB F3             jp extra_mouse_event
  46+ F388
  47+ F388              ; -----------------------------------------------------------------------------
  48+ F388              ; EXTRA_KEYSCAN_UI - KEYSCAN, ktery umi i mys (resident: KEYSCAN_UI)
  49+ F388              ; OUT: D, E jako KEYSCAN. Novy stisk tlacitka nebo pohyb kolecka se vrati
  50+ F388              ;      jako kod odpovidajici klavesy (napr. prave tlacitko = CAPS+SPACE).
  51+ F388              ; -----------------------------------------------------------------------------
  52+ F388              EXTRA_KEYSCAN_UI:
  53+ F388 CD DD A6             call MOUSE                       ; A = tlacitka
  54+ F38B 47                   ld b,a
  55+ F38C 3A 8A F8             ld a,(mouseScanButtons)
  56+ F38F 2F                   cpl
  57+ F390 A0                   and b                            ; jen nove stisknuta
  58+ F391 4F                   ld c,a
  59+ F392 78                   ld a,b
  60+ F393 32 8A F8             ld (mouseScanButtons),a
  61+ F396 C5                   push bc
  62+ F397 CD 71 F4             call extra_mouse_sprite_moved
  63+ F39A C1                   pop bc
  64+ F39B 41                   ld b,c
  65+ F39C 3E 00                ld a,MOUSE_CTX_DIALOG
  66+ F39E CD EB F3             call extra_mouse_event           ; resi i kolecko (B = 0)
  67+ F3A1 7A                   ld a,d
  68+ F3A2 A3                   and e
  69+ F3A3 3C                   inc a
  70+ F3A4 C0                   ret nz                           ; DE = klavesa z mysi
  71+ F3A5 C3 31 80             jp KEYSCAN
  72+ F3A8
  73+ F3A8              ; -----------------------------------------------------------------------------
  74+ F3A8              ; EXTRA_MOUSE_PLUGIN - klik v prohlizeci (view_plugin_input_body)
  75+ F3A8              ; IN : A = tlacitka z MOUSE
  76+ F3A8              ; OUT: A = klavesa, nebo 0 = pokracovat puvodni obsluhou podle typu
  77+ F3A8              ; -----------------------------------------------------------------------------
  78+ F3A8              EXTRA_MOUSE_PLUGIN:
  79+ F3A8 47                   ld b,a
  80+ F3A9 CB 40                bit 0,b
  81+ F3AB 20 1B                jr nz,.event                     ; prave tlacitko = BREAK u vsech
  82+ F3AD 3A 3B BB             ld a,(viewPluginType)
  83+ F3B0 FE 02                cp VIEWTYPE_ZXSCREEN
  84+ F3B2 28 19                jr z,.own                        ; obrazky, hudba a hello maji
  85+ F3B4 FE 08                cp VIEWTYPE_NXI                  ; tlacitka na pevnych mistech
  86+ F3B6 28 15                jr z,.own
  87+ F3B8 FE 09                cp VIEWTYPE_HELLO
  88+ F3BA 28 11                jr z,.own
  89+ F3BC FE 0C                cp VIEWTYPE_EDIT
  90+ F3BE 28 0F                jr z,.edit
  91+ F3C0 FE 03                cp VIEWTYPE_PT3
  92+ F3C2 38 04                jr c,.event
  93+ F3C4 FE 08                cp VIEWTYPE_SQT+1
  94+ F3C6 38 05                jr c,.own                        ; PT3, PT2, STC, STP, SQT
  95+ F3C8              .event
  96+ F3C8 3E 02                ld a,MOUSE_CTX_PLUGIN
  97+ F3CA C3 EB F3             jp extra_mouse_event
  98+ F3CD              .own
  99+ F3CD AF                   xor a
 100+ F3CE C9                   ret
 101+ F3CF              .edit
 102+ F3CF                      ; editor: "EXT+S save" je SYMBOL+S, ten prevadi tabulka prohlizece
 103+ F3CF 3E 02                ld a,MOUSE_CTX_PLUGIN
 104+ F3D1 CD EB F3             call extra_mouse_event
