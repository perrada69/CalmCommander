   2+ A789              ; CONTROL / CONTROL_CLICK
   3+ A789              ;
   4+ A789              ; Rutina kontroluje, zda aktuální souřadnice kliknutí (uložené v COORD)
   5+ A789              ; leží uvnitř obdélníku, jehož hranice jsou předány v HL.
   6+ A789              ;
   7+ A789              ; Formát dat na adrese HL:
   8+ A789              ;   +0  minX
   9+ A789              ;   +1  minY
  10+ A789              ;   +2  maxX
  11+ A789              ;   +3  maxY
  12+ A789              ;
  13+ A789              ; COORD:
  14+ A789              ;   COORD+0 = X pozice kliknutí
  15+ A789              ;   COORD+1 = Y pozice kliknutí
  16+ A789              ;
  17+ A789              ; Výstup:
  18+ A789              ;   Carry = 1  → kliknutí mimo oblast
  19+ A789              ;   Carry = 0  → kliknutí uvnitř oblasti
  20+ A789              ;
  21+ A789              ; HL je během rutiny inkrementováno.
  22+ A789              ; -----------------------------------------------------------------------------
