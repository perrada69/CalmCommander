 527+ A9C2
 528+ A9C2                      ; smaž staré zvýraznění / kurzor
 529+ A9C2 3E 30                ld a,48
 530+ A9C4 CD 5C AA             call writecurmenu
 531+ A9C7
 532+ A9C7 D1                   pop de                  ; vrať D = řádek
 533+ A9C8
 534+ A9C8                      ; nastav nový řádek kurzoru (pozor: curmeny+1 je SMC operand)
 535+ A9C8 7A                   ld a,d
 536+ A9C9 32 66 AA             ld (curmeny+1),a        ; řádek kurzoru = Y/8
 537+ A9CC
 538+ A9CC                      ; menucur je index položky od 0, zatímco curmeny je typicky od 1
 539+ A9CC 3D                   dec a
 540+ A9CD 32 6C AB             ld (menucur),a
 541+ A9D0
 542+ A9D0                      ; vykresli nové zvýraznění / kurzor
 543+ A9D0 3E 40                ld a,64
 544+ A9D2 CD 5C AA             call writecurmenu
